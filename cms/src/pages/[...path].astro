---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import SiteFooter from "../../../src/components/SiteFooter.astro";
import SiteHeader from "../../../src/components/SiteHeader.astro";
import { localizedPath, translations, type Locale } from "../../../src/i18n";
import { productCategories } from "../lib/product-categories";
import { guideCovers, resolveSeoImageUrl } from "../lib/guide-covers";

const segments = (Astro.params.path || "").split("/").filter(Boolean);
const locale: Locale = segments[0] === "de" || segments[0] === "fr" ? segments.shift() as Locale : "en";
const labels = {
  en: { title: "Product guides", intro: "Installation, setup and practical support for your scooter parts.", all: "All products", empty: "No guides have been published for this product yet. Contact us if you need help.", error: "Guides are temporarily unavailable. Please try again later.", articles: "Guides & tutorials", video: "Video tutorial" },
  de: { title: "Produktanleitungen", intro: "Montage, Einrichtung und praktische Hilfe für Ihre Scooter-Teile.", all: "Alle Produkte", empty: "Für dieses Produkt wurden noch keine Anleitungen veröffentlicht. Kontaktieren Sie uns, wenn Sie Hilfe benötigen.", error: "Die Anleitungen sind vorübergehend nicht verfügbar. Bitte versuchen Sie es später erneut.", articles: "Anleitungen & Tutorials", video: "Videoanleitung" },
  fr: { title: "Guides produits", intro: "Installation, réglages et assistance pour les pièces de votre trottinette.", all: "Tous les produits", empty: "Aucun guide n’a encore été publié pour ce produit. Contactez-nous si vous avez besoin d’aide.", error: "Les guides sont temporairement indisponibles. Veuillez réessayer plus tard.", articles: "Guides et tutoriels", video: "Tutoriel vidéo" },
}[locale];
let products: Awaited<ReturnType<typeof productCategories>> = [];
try { products = await productCategories(locale, Astro.locals.emdash?.getPublicMediaUrl); }
catch { return new Response(labels.error, { status: 503 }); }
const isArticle = segments[0] === "articles" && segments.length === 2;
const isProduct = segments[0] === "products" && segments.length === 2;
const product = isProduct ? products.find(item => item.slug === segments[1]) : undefined;
if (segments.length && !isArticle && !product) return new Response("Not found", { status: 404 });
let article;
let entries = [];
let failed = false;
if (isArticle) {
  const result = await getEmDashEntry("guides", segments[1], { locale });
  if (result.error) return new Response(labels.error, { status: 503 });
  article = result.entry;
  if (!article) return new Response("Not found", { status: 404 });
} else if (isProduct) {
  const result = await getEmDashEntry("product_categories", product!.slug, { locale, references: { guides: { limit: 100 } } });
  entries = result.entry?.references?.guides?.entries || [];
  failed = Boolean(result.error);
  if (failed) Astro.response.status = 503;
}
const page = segments.length ? `${segments.join("/")}/` : "";
const title = article?.data.title || product?.name || labels.title;
function safeMedia(value: unknown) {
  if (typeof value !== "string" || !value) return undefined;
  try { const url = new URL(value); return url.protocol === "https:" && url.hostname === "media.scooter.work" ? url.href : undefined; } catch { return undefined; }
}
const video = safeMedia(article?.data.video_url);
const covers = isProduct && entries.length
  ? await guideCovers(entries, { db: Astro.locals.emdash?.db, locale, resolveMediaUrl: Astro.locals.emdash?.getPublicMediaUrl })
  : new Map<string, string>();
let ogImage = article
  ? resolveSeoImageUrl((article.data as { seo?: { image?: unknown } }).seo?.image, Astro.locals.emdash?.getPublicMediaUrl)
  : "";
if (article && !ogImage) {
  const articleCovers = await guideCovers([article], { db: Astro.locals.emdash?.db, locale, resolveMediaUrl: Astro.locals.emdash?.getPublicMediaUrl });
  ogImage = articleCovers.get(String(article.data.id || "")) || safeMedia(article.data.poster_url) || "";
}
const dateFormat = new Intl.DateTimeFormat(locale, { dateStyle: "medium", timeZone: "UTC" });
const siteCopy = translations[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Scooter.work</title>
    <meta name="description" content={article?.data.summary || product?.description || labels.intro} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="canonical" href={new URL(localizedPath(locale, page), Astro.site)} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
  </head>
  <body>
    <SiteHeader locale={locale} active="guides" variant="light" page={page} baseUrl="https://scooter.work" />

    <main class="shell">
      {segments.length > 0 && (
        <a class="back-link" href={localizedPath(locale)}>← {labels.all}</a>
      )}
      <p class="eyebrow">{labels.articles}</p>
      <h1>{title}</h1>
      {!article && <p class="intro">{product?.description || labels.intro}</p>}

      {!segments.length && (
        <div class="product-grid">
          {products.map(item => (
            <a class="product-card" href={localizedPath(locale, `products/${item.slug}/`)}>
              <div class="product-image">
                {item.image && <img src={item.image} alt={item.alt} width="400" height="300" loading="lazy" />}
              </div>
              <div class="product-body">
                <h2>{item.name}</h2>
                <p>{item.description}</p>
                <span class="product-cta">{labels.articles} ↗</span>
              </div>
            </a>
          ))}
        </div>
      )}

      {isProduct && (
        <section class="articles">
          {failed ? (
            <p class="status-msg">{labels.error}</p>
          ) : entries.length ? (
            entries.map(entry => {
              const cover = covers.get(String(entry.data.id || "")) || "";
              const date = entry.data.publishedAt ? new Date(String(entry.data.publishedAt)) : null;
              return (
                <a class="article-card" href={localizedPath(locale, `articles/${encodeURIComponent(String(entry.data.slug || entry.id.split("/").pop()))}/`)}>
                  {cover && (
                    <div class="article-cover">
                      <img src={cover} alt="" loading="lazy" />
                    </div>
                  )}
                  <div class="article-body">
                    <h2>{entry.data.title}</h2>
                    {entry.data.summary && <p>{entry.data.summary}</p>}
                    {date && !Number.isNaN(date.getTime()) && (
                      <time datetime={date.toISOString()}>{dateFormat.format(date)}</time>
                    )}
                  </div>
                </a>
              );
            })
          ) : (
            <p class="status-msg">{labels.empty}</p>
          )}
        </section>
      )}

      {article && (
        <article class="guide-article">
          {article.data.summary && <p class="article-summary">{article.data.summary}</p>}
          {video && (
            <video controls playsinline preload="metadata" poster={safeMedia(article.data.poster_url)} aria-label={labels.video}>
              <source src={video} type="video/mp4" />
              <a href={video}>{labels.video}</a>
            </video>
          )}
          <div class="article-prose">
            <PortableText value={article.data.content || []} />
          </div>
        </article>
      )}

      <div class="support-box">
        <span>{siteCopy.contact}:</span>
        <a href="mailto:support@scooter.work">support@scooter.work</a>
        <span aria-hidden="true">·</span>
        <a href="https://wa.me/447873353246" target="_blank" rel="noreferrer">WhatsApp: +44 7873 353246</a>
      </div>
    </main>

    <SiteFooter locale={locale} baseUrl="https://scooter.work" />
  </body>
</html>

<style>
  @font-face { font-family: "Inter"; src: url("/fonts/inter-400.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-500.ttf") format("truetype"); font-style: normal; font-weight: 500; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-600.ttf") format("truetype"); font-style: normal; font-weight: 600; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-700.ttf") format("truetype"); font-style: normal; font-weight: 700; font-display: swap; }

  :root {
    --bg: #ffffff;
    --surface: #f7f8fa;
    --line: #e6e9ee;
    --line-soft: #eaedf2;
    --text: #111418;
    --muted: #5c646d;
    --accent: #f56600;
    --accent-hover: #de5a00;
  }

  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
    font-family: "Inter", Arial, sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  main { flex: 1; padding-block: 48px 72px; }
  a { color: inherit; text-decoration: none; }
  h1, h2, p { margin: 0; }
  .shell { width: min(1240px, calc(100% - 48px)); margin-inline: auto; }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    margin-bottom: 20px;
    border: 1px solid #d5dae1;
    border-radius: 0;
    background: var(--surface);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    transition: border-color 150ms ease, color 150ms ease, background 150ms ease;
  }
  .back-link:hover {
    border-color: var(--accent);
    color: var(--accent);
    background: #fff4ec;
  }
  .back-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 10px;
  }
  h1 {
    font-size: clamp(1.85rem, 1.2rem + 2.2vw, 2.85rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .intro {
    max-width: 720px;
    margin-top: 12px;
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.7;
  }

  /* PRODUCT CATEGORY GRID (/) */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--line-soft);
    border-radius: 0;
    cursor: pointer;
    transition: border-color 160ms ease;
  }
  .product-card:hover { border-color: rgba(245, 102, 0, 0.55); }
  .product-image {
    aspect-ratio: 4 / 3;
    background: #ffffff;
    padding: 14px;
    border-bottom: 1px solid #f0f2f5;
  }
  .product-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .product-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 14px;
    padding: 18px 20px 20px;
  }
  .product-body h2 {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .product-body p {
    flex: 1;
    background: var(--surface);
    padding: 12px 14px;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.6;
  }
  .product-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 40px;
    padding: 10px 16px;
    background: var(--accent);
    color: #ffffff;
    font-size: 13.5px;
    font-weight: 600;
    transition: background 150ms ease;
  }
  .product-card:hover .product-cta { background: var(--accent-hover); }

  /* PRODUCT ARTICLES GRID (/products/<slug>/) */
  .articles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }
  .article-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #ffffff;
    border: 1px solid var(--line-soft);
    border-radius: 0;
    cursor: pointer;
    overflow-wrap: anywhere;
    transition: border-color 150ms ease;
  }
  .article-card:hover { border-color: rgba(245, 102, 0, 0.55); }
  .article-card:hover h2 { color: var(--accent); }
  .article-cover {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--surface);
    border-bottom: 1px solid #f0f2f5;
  }
  .article-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 8px;
    padding: 18px 20px;
  }
  .article-body h2 {
    font-size: 16.5px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text);
    transition: color 150ms ease;
  }
  .article-body p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .article-body time {
    margin-top: auto;
    padding-top: 4px;
    color: #7b848e;
    font-size: 13px;
  }
  .status-msg { color: var(--muted); font-size: 14.5px; }

  /* SINGLE GUIDE ARTICLE (/articles/<slug>/) */
  .guide-article {
    max-width: 860px;
    margin-top: 28px;
    overflow-wrap: anywhere;
  }
  .article-summary {
    padding: 18px 20px;
    background: var(--surface);
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
    white-space: pre-line;
    margin-bottom: 24px;
  }
  video {
    display: block;
    width: 100%;
    background: #000000;
    border: 1px solid var(--line);
    margin-bottom: 24px;
  }
  .article-prose {
    color: var(--text);
    font-size: 15.5px;
    line-height: 1.75;
  }
  .article-prose :global(h2),
  .article-prose :global(h3) {
    margin: 28px 0 12px;
    color: var(--text);
    font-weight: 700;
    line-height: 1.3;
  }
  .article-prose :global(p),
  .article-prose :global(ul),
  .article-prose :global(ol) {
    margin: 0 0 16px;
  }
  .article-prose :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
    margin: 18px 0;
  }
  .article-prose :global(a) {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .support-box {
    margin-top: 48px;
    padding: 16px 20px;
    background: var(--surface);
    border: 1px solid var(--line-soft);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    font-size: 13.5px;
    color: var(--muted);
  }
  .support-box a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  main a:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  @media (max-width: 1099px) {
    .product-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 960px) {
    .articles { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 780px) {
    .shell { width: min(100% - 32px, 680px); }
    main { padding-block: 32px 56px; }
  }
  @media (max-width: 640px) {
    .product-grid,
    .articles { grid-template-columns: 1fr; }
  }
</style>
