---
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import LanguageSwitcher from "../../../src/components/LanguageSwitcher.astro";
import { localizedPath, type Locale } from "../../../src/i18n";
import { productCategories } from "../lib/product-categories";
import { guideCovers, resolveSeoImageUrl } from "../lib/guide-covers";

const segments = (Astro.params.path || "").split("/").filter(Boolean);
const locale: Locale = segments[0] === "de" || segments[0] === "fr" ? segments.shift() as Locale : "en";
const labels = {
  en: { title: "Product guides", intro: "Installation, setup and practical support for your scooter parts.", home: "Main website", all: "All products", empty: "No guides have been published for this product yet. Contact us if you need help.", error: "Guides are temporarily unavailable. Please try again later.", articles: "Guides & tutorials", video: "Video tutorial" },
  de: { title: "Produktanleitungen", intro: "Montage, Einrichtung und praktische Hilfe für Ihre Scooter-Teile.", home: "Zur Hauptwebsite", all: "Alle Produkte", empty: "Für dieses Produkt wurden noch keine Anleitungen veröffentlicht. Kontaktieren Sie uns, wenn Sie Hilfe benötigen.", error: "Die Anleitungen sind vorübergehend nicht verfügbar. Bitte versuchen Sie es später erneut.", articles: "Anleitungen & Tutorials", video: "Videoanleitung" },
  fr: { title: "Guides produits", intro: "Installation, réglages et assistance pour les pièces de votre trottinette.", home: "Site principal", all: "Tous les produits", empty: "Aucun guide n’a encore été publié pour ce produit. Contactez-nous si vous avez besoin d’aide.", error: "Les guides sont temporairement indisponibles. Veuillez réessayer plus tard.", articles: "Guides et tutoriels", video: "Tutoriel vidéo" },
}[locale];
let products: Awaited<ReturnType<typeof productCategories>> = [];
try { products = await productCategories(locale, Astro.locals.emdash?.getPublicMediaUrl); }
catch { return new Response(labels.error, { status: 503 }); }
const isArticle = segments[0] === "articles" && segments.length === 2;
const isProduct = segments[0] === "products" && segments.length === 2;
const product = isProduct ? products.find(item => item.slug === segments[1]) : undefined;
if (segments.length && !isArticle && !product) return new Response("Not found", { status: 404 });
let article;
let entries = [];
let failed = false;
if (isArticle) {
  const result = await getEmDashEntry("guides", segments[1], { locale });
  if (result.error) return new Response(labels.error, { status: 503 });
  article = result.entry;
  if (!article) return new Response("Not found", { status: 404 });
} else if (isProduct) {
  const result = await getEmDashEntry("product_categories", product!.slug, { locale, references: { guides: { limit: 100 } } });
  entries = result.entry?.references?.guides?.entries || [];
  failed = Boolean(result.error);
  if (failed) Astro.response.status = 503;
}
const page = segments.length ? `${segments.join("/")}/` : "";
const title = article?.data.title || product?.name || labels.title;
function safeMedia(value: unknown) {
  if (typeof value !== "string" || !value) return undefined;
  try { const url = new URL(value); return url.protocol === "https:" && url.hostname === "media.scooter.work" ? url.href : undefined; } catch { return undefined; }
}
const video = safeMedia(article?.data.video_url);
const covers = isProduct && entries.length
  ? await guideCovers(entries, { db: Astro.locals.emdash?.db, locale, resolveMediaUrl: Astro.locals.emdash?.getPublicMediaUrl })
  : new Map<string, string>();
let ogImage = article
  ? resolveSeoImageUrl((article.data as { seo?: { image?: unknown } }).seo?.image, Astro.locals.emdash?.getPublicMediaUrl)
  : "";
if (article && !ogImage) {
  const articleCovers = await guideCovers([article], { db: Astro.locals.emdash?.db, locale, resolveMediaUrl: Astro.locals.emdash?.getPublicMediaUrl });
  ogImage = articleCovers.get(String(article.data.id || "")) || safeMedia(article.data.poster_url) || "";
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Scooter.work</title>
    <meta name="description" content={article?.data.summary || product?.description || labels.intro} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <link rel="canonical" href={new URL(localizedPath(locale, page), Astro.site)} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
  </head>
  <body>
    <header class="shell">
      <a class="brand" href={`https://scooter.work${localizedPath(locale)}`}>
        <img class="brand-logo" src="/logo.png" alt="Scooter.work" width="34" height="34" />
      </a>
      <nav><a href={localizedPath(locale)}>{labels.all}</a><LanguageSwitcher locale={locale} page={page} /></nav>
    </header>
    <main class="shell">
      <p class="eyebrow">{labels.articles}</p>
      <h1>{title}</h1>
      {!article && <p class="intro">{product?.description || labels.intro}</p>}
      {!segments.length && <div class="product-grid">{products.map(item => (
        <a class="product" href={localizedPath(locale, `products/${item.slug}/`)}>
          {item.image && <img src={item.image} alt={item.alt} width="400" height="400" loading="lazy" />}
          <h2>{item.name} <span>↗</span></h2>
          <p>{item.description}</p>
        </a>
      ))}</div>}
      {isProduct && <section class="articles">
        {failed ? <p>{labels.error}</p> : entries.length ? entries.map(entry => {
          const cover = covers.get(String(entry.data.id || "")) || "";
          return (
            <a class="article-card" href={localizedPath(locale, `articles/${encodeURIComponent(String(entry.data.slug || entry.id.split("/").pop()))}/`)}>
              {cover && <img class="article-cover" src={cover} alt="" loading="lazy" />}
              <h2>{entry.data.title} <span>↗</span></h2><p>{entry.data.summary}</p>
            </a>
          );
        }) : <p>{labels.empty}</p>}
      </section>}
      {article && <article>
        {article.data.summary && <p class="intro">{article.data.summary}</p>}
        {video && <video controls playsinline preload="metadata" poster={safeMedia(article.data.poster_url)} aria-label={labels.video}><source src={video} type="video/mp4" /><a href={video}>{labels.video}</a></video>}
        <PortableText value={article.data.content || []} />
      </article>}
      <p class="contact"><a href="mailto:support@scooter.work">support@scooter.work</a> · <a href="https://wa.me/447873353246">WhatsApp: +44 7873 353246</a></p>
    </main>
    <footer class="shell"><a href={`https://scooter.work${localizedPath(locale)}`}>{labels.home} ↗</a><small>© {new Date().getFullYear()} SCOOTER.WORK</small></footer>
  </body>
</html>

<style>
  @font-face { font-family: "Inter"; src: url("/fonts/inter-400.ttf"); font-display: swap; }
  @font-face { font-family: "Archivo Black"; src: url("/fonts/archivo-black.ttf"); font-display: swap; }
  :root { color-scheme: dark; --bg: #111515; --panel: #1a2020; --text: #edf2e8; --muted: #9ca7a2; --acid: #ff7a1a; --line: rgba(238,244,232,.14); }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: Inter, Arial, sans-serif; line-height: 1.7; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--acid); }
  a:focus-visible { outline: 2px solid var(--acid); outline-offset: 4px; }
  .shell { width: min(1200px, calc(100% - 32px)); margin-inline: auto; }
  header, nav, footer { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  header { min-height: 88px; padding-block: 18px; border-bottom: 1px solid var(--line); }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-family: "Archivo Black", sans-serif; letter-spacing: 2px; }
  .brand-logo { display: block; width: 34px; height: 34px; flex-shrink: 0; }
  .brand > span > span, .eyebrow, h2 span { color: var(--acid); }
  main { padding-block: 64px; min-height: 65dvh; }
  h1 { font-family: "Archivo Black", sans-serif; font-size: clamp(2rem, 1rem + 4vw, 4rem); line-height: 1.15; overflow-wrap: anywhere; }
  .intro, .contact, footer { color: var(--muted); }
  .product-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: 20px; margin-block: 40px; }
  .product, .article-card { display: block; padding: 20px; background: var(--panel); border: 1px solid var(--line); }
  .product img { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; background: #fff; }
  h2 { font-size: 1.2rem; overflow-wrap: anywhere; }
  .articles { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 20px; margin-block: 40px; }
  .article-card .article-cover { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: 14px; }
  article { max-width: 860px; margin-block: 40px; overflow-wrap: anywhere; }
  article :global(img), article :global(video), video { max-width: 100%; height: auto; }
  video { width: 100%; background: #000; margin-bottom: 24px; }
  article :global(a) { color: var(--acid); text-decoration: underline; }
  .contact { margin-top: 48px; }
  footer { padding-block: 28px; border-top: 1px solid var(--line); }
</style>
