---
import { localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  page?: string;
}

const { locale, page = "" } = Astro.props;
const options: { code: Locale; label: string; lang: string }[] = [
  { code: "zh", label: "中文", lang: "zh-CN" },
  { code: "en", label: "EN", lang: "en" },
];
---

<div class="lang-switch" role="group" aria-label={translations[locale].nav.languageLabel}>
  {options.map((opt) => (
    <a
      href={localizedPath(opt.code, page)}
      lang={opt.lang}
      hreflang={opt.code === "zh" ? "zh-Hans" : opt.code}
      data-locale={opt.code}
      class:list={["lang-item", { active: opt.code === locale }]}
      aria-current={opt.code === locale ? "page" : undefined}
    >
      {opt.label}
    </a>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>(".lang-switch a[data-locale]").forEach((link) => {
    link.addEventListener("click", () => {
      try {
        localStorage.setItem("about-scooterwork-language", link.dataset.locale!);
      } catch {}
    });
  });
</script>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: stretch;
    background: #ffffff;
    border: 1px solid #dce1e7;
    border-radius: 0;
    flex-shrink: 0;
  }
  .lang-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0 11px;
    font-size: 12px;
    font-weight: 600;
    color: #5c646d;
    text-decoration: none;
    transition: background 150ms ease, color 150ms ease;
  }
  .lang-item + .lang-item {
    border-left: 1px solid #e6e9ee;
  }
  .lang-item:hover {
    color: #111418;
    background: #f7f8fa;
  }
  .lang-item.active {
    background: #f56600;
    color: #ffffff;
  }
  .lang-item:focus-visible {
    outline: 2px solid #f56600;
    outline-offset: 2px;
  }
</style>
