---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LocaleHead from "./LocaleHead.astro";
import { localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = translations[locale];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={copy.langAttr}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:url" content={new URL(localizedPath(locale), Astro.site).href} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <title>{copy.title}</title>
    <LocaleHead locale={locale} />
  </head>
  <body>
    <!-- TOP BAR -->
    <div class="topbar">
      <div class="container topbar-inner">
        <span class="topbar-company">{copy.hero.companyName}</span>
        <div class="topbar-right">
          <a href="tel:+8615800009272">+86 15800009272</a>
          <span class="topbar-sep" aria-hidden="true">|</span>
          <a href="mailto:support@scooter.work">support@scooter.work</a>
          <span class="topbar-sep topbar-sep-ext" aria-hidden="true">|</span>
          <a class="topbar-ext" href="https://scooter.work/" target="_blank" rel="noreferrer">{copy.nav.mainSite} ↗</a>
          <a class="topbar-ext" href="https://guides.scooter.work/" target="_blank" rel="noreferrer">{copy.nav.guidesSite} ↗</a>
        </div>
      </div>
    </div>

    <!-- MAIN NAVIGATION -->
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={localizedPath(locale)}>
          <img class="brand-logo" src="/logo.png" alt="Scooter.work" width="34" height="34" />
          <span class="brand-sub">{copy.nav.aboutTag}</span>
        </a>

        <nav class="main-nav" aria-label={copy.nav.ariaLabel}>
          <a href="#overview">{copy.nav.about}</a>
          <a href="#brands">{copy.nav.brands}</a>
          <a href="#operations">{copy.nav.operations}</a>
          <a href="#facilities">{copy.nav.facilities}</a>
          <a href="#partnership">{copy.nav.partnership}</a>
          <a href="#contact">{copy.nav.contact}</a>
        </nav>

        <div class="header-right">
          <LanguageSwitcher locale={locale} />
          <button
            class="menu-btn"
            type="button"
            aria-label={copy.nav.menuToggle}
            aria-expanded="false"
            aria-controls="mobile-nav"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>
      </div>

      <div class="mobile-nav" id="mobile-nav" hidden>
        <div class="container mobile-nav-inner">
          <a href="#overview">{copy.nav.about}</a>
          <a href="#brands">{copy.nav.brands}</a>
          <a href="#operations">{copy.nav.operations}</a>
          <a href="#facilities">{copy.nav.facilities}</a>
          <a href="#partnership">{copy.nav.partnership}</a>
          <a href="#contact">{copy.nav.contact}</a>
          <div class="mobile-nav-links">
            <a href="https://scooter.work/" target="_blank" rel="noreferrer">scooter.work ↗</a>
            <a href="https://guides.scooter.work/" target="_blank" rel="noreferrer">guides.scooter.work ↗</a>
          </div>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO BANNER -->
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-text">
            <p class="hero-company-sub">{copy.hero.companySub}</p>
            <h1>{copy.hero.companyName}</h1>
            <p class="hero-subtitle">{copy.hero.headline}</p>
            <p class="hero-summary">{copy.hero.summary}</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#contact">{copy.hero.primaryCta}</a>
              <a class="btn btn-outline-light" href="https://scooter.work/" target="_blank" rel="noreferrer">
                {copy.hero.secondaryCta} ↗
              </a>
            </div>
          </div>

          <div class="hero-media">
            <img src="/images/company/sign-wide.jpg" alt={copy.hero.signAlt} width="1024" height="576" />
          </div>
        </div>
      </section>

      <!-- KEY FACTS STRIP -->
      <div class="facts-bar">
        <div class="container">
          <dl class="facts-grid">
            {copy.hero.facts.map((item) => (
              <div class="fact-item">
                <dd>{item.value}</dd>
                <dt>{item.label}</dt>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- COMPANY OVERVIEW & ORGANIZATION -->
      <section class="section section-white" id="overview">
        <div class="container">
          <div class="section-head">
            <h2>{copy.overview.title}</h2>
          </div>

          <div class="overview-grid">
            <figure class="overview-photo">
              <img src="/images/company/office-team.jpg" alt={copy.overview.photoAlt} loading="lazy" width="1024" height="575" />
              <figcaption>{copy.overview.photoCaption}</figcaption>
            </figure>

            <div class="overview-org">
              <h3>{copy.overview.departmentsTitle}</h3>
              <dl class="dept-table">
                {copy.overview.departments.map((dept) => (
                  <div class="dept-row">
                    <dt>{dept.name}</dt>
                    <dd>{dept.detail}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </div>
      </section>

      <!-- PARTNERS & OWN BRAND -->
      <section class="section section-gray" id="brands">
        <div class="container">
          <div class="section-head">
            <h2>{copy.brands.partnersTitle}</h2>
          </div>

          <div class="partner-grid">
            {copy.brands.partners.map((partner) => (
              <article class="partner-card">
                <div class="partner-logo">
                  <img class={partner.logoClass} src={partner.logo} alt={partner.name} loading="lazy" />
                </div>
                <p>{partner.description}</p>
                <a class="text-link" href={partner.href} target="_blank" rel="noreferrer">
                  {partner.domain} ↗
                </a>
              </article>
            ))}
          </div>

          <div class="section-head sub-head">
            <h2>{copy.brands.ownBrandTitle}</h2>
          </div>

          <article class="own-brand-row">
            <div class="own-brand-logo">
              <img src={copy.brands.ownBrand.logo} alt={copy.brands.ownBrand.name} loading="lazy" />
            </div>
            <div class="own-brand-body">
              <p>{copy.brands.ownBrand.description}</p>
              <a class="text-link" href={copy.brands.ownBrand.href} target="_blank" rel="noreferrer">
                {copy.brands.ownBrand.domain} ↗
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- CROSS-BORDER OPERATIONS -->
      <section class="section section-white" id="operations">
        <div class="container">
          <div class="section-head">
            <h2>{copy.operations.title}</h2>
          </div>

          <div class="ops-split">
            <div class="ops-text">
              <p class="ops-summary">{copy.operations.summary}</p>
              <dl class="ops-list">
                {copy.operations.points.map((point) => (
                  <div class="ops-item">
                    <dt>{point.title}</dt>
                    <dd>{point.detail}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <figure class="ops-photo">
              <img src="/images/company/shopify-trophy.jpg" alt={copy.operations.trophyAlt} loading="lazy" width="1024" height="576" />
              <figcaption>{copy.operations.trophyCaption}</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- WAREHOUSE, WORKSHOP & R&D -->
      <section class="section section-gray" id="facilities">
        <div class="container">
          <div class="section-head">
            <h2>{copy.facilities.title}</h2>
          </div>

          <div class="photo-grid">
            {copy.facilities.photos.map((photo) => (
              <figure class="photo-card">
                <div class="photo-frame">
                  <img src={photo.src} alt={photo.caption} loading="lazy" width="1024" height="575" />
                </div>
                <figcaption>{photo.caption}</figcaption>
              </figure>
            ))}
          </div>

          <div class="rd-block">
            <h3>{copy.facilities.rdTitle}</h3>
            <div class="rd-grid">
              {copy.facilities.rdItems.map((item) => (
                <figure class="rd-card">
                  <div class="rd-thumb">
                    <img src={item.image} alt={item.name} loading="lazy" />
                  </div>
                  <figcaption>{item.name}</figcaption>
                </figure>
              ))}
            </div>
            <p class="rd-note">
              {copy.facilities.rdNote}{" "}
              <a href="https://scooter.work/" target="_blank" rel="noreferrer">scooter.work ↗</a>
              {" · "}
              <a href="https://guides.scooter.work/" target="_blank" rel="noreferrer">guides.scooter.work ↗</a>
            </p>
          </div>
        </div>
      </section>

      <!-- PARTNERSHIP MODELS -->
      <section class="section section-white" id="partnership">
        <div class="container">
          <div class="section-head">
            <h2>{copy.partnership.title}</h2>
          </div>
          <p class="section-intro">{copy.partnership.summary}</p>

          <div class="coop-grid">
            {copy.partnership.models.map((model) => (
              <article class="coop-card">
                <h3>{model.title}</h3>
                <p>{model.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- CONTACT -->
      <section class="section-contact" id="contact">
        <div class="container contact-grid">
          <div class="contact-info">
            <h2>{copy.contact.title}</h2>
            <p class="contact-company">{copy.contact.company}</p>
            <p class="contact-address">{copy.contact.address}</p>
          </div>

          <div class="contact-channels">
            <div class="channel-row">
              <span class="channel-label">{copy.contact.phoneLabel}</span>
              <a class="channel-val" href="tel:+8615800009272">+86 15800009272</a>
              <button
                class="copy-btn"
                type="button"
                data-copy="+86 15800009272"
                data-label={copy.contact.copy}
                data-copied={copy.contact.copied}
              >
                {copy.contact.copy}
              </button>
            </div>

            <div class="channel-row">
              <span class="channel-label">{copy.contact.emailLabel}</span>
              <a class="channel-val" href="mailto:support@scooter.work">support@scooter.work</a>
              <button
                class="copy-btn"
                type="button"
                data-copy="support@scooter.work"
                data-label={copy.contact.copy}
                data-copied={copy.contact.copied}
              >
                {copy.contact.copy}
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- CORPORATE FOOTER -->
    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-col">
          <div class="footer-brand">
            <img class="brand-logo" src="/logo.png" alt="Scooter.work" width="30" height="30" />
          </div>
          <p class="footer-meta">{copy.contact.company}</p>
          <p class="footer-meta">{copy.contact.address}</p>
        </div>

        <div class="footer-col">
          <h4>{copy.contact.footerLinksTitle}</h4>
          <ul>
            <li><a href="https://scooter.work/" target="_blank" rel="noreferrer">scooter.work ↗</a></li>
            <li><a href="https://guides.scooter.work/" target="_blank" rel="noreferrer">guides.scooter.work ↗</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h4>{copy.contact.storesTitle}</h4>
          <ul class="footer-stores">
            <li><a href="https://jofenscooter.com" target="_blank" rel="noreferrer">jofenscooter.com</a></li>
            <li><a href="https://joyorprime.com" target="_blank" rel="noreferrer">joyorprime.com</a></li>
            <li><a href="https://naveescooter.com" target="_blank" rel="noreferrer">naveescooter.com</a></li>
            <li><a href="https://kukirinprime.com" target="_blank" rel="noreferrer">kukirinprime.com</a></li>
          </ul>
        </div>
      </div>

      <div class="footer-bottom">
        <div class="container footer-bottom-inner">
          <small>© {year} {copy.contact.copyright}</small>
          <small>about.scooter.work</small>
        </div>
      </div>
    </footer>
  </body>
</html>

<script>
  const menuBtn = document.querySelector<HTMLButtonElement>(".menu-btn");
  const mobileNav = document.querySelector<HTMLElement>("#mobile-nav");
  if (menuBtn && mobileNav) {
    const close = () => {
      mobileNav.hidden = true;
      menuBtn.setAttribute("aria-expanded", "false");
    };
    menuBtn.addEventListener("click", () => {
      const open = mobileNav.hidden;
      mobileNav.hidden = !open;
      menuBtn.setAttribute("aria-expanded", String(open));
    });
    mobileNav.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !mobileNav.hidden) {
        close();
        menuBtn.focus();
      }
    });
  }

  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    let timer: number | undefined;
    btn.addEventListener("click", async () => {
      const value = btn.dataset.copy;
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = btn.dataset.copied || "Copied";
        btn.classList.add("copied");
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.textContent = btn.dataset.label || "Copy";
          btn.classList.remove("copied");
        }, 1800);
      } catch {}
    });
  });
</script>

<style>
  @font-face { font-family: "Archivo Black"; src: url("/fonts/archivo-black.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-400.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-500.ttf") format("truetype"); font-style: normal; font-weight: 500; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-600.ttf") format("truetype"); font-style: normal; font-weight: 600; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-700.ttf") format("truetype"); font-style: normal; font-weight: 700; font-display: swap; }

  :root {
    --dark: #111515;
    --dark-2: #191f1f;
    --dark-line: rgba(255, 255, 255, 0.12);
    --orange: #ff7a1a;
    --orange-dark: #d95f08;
    --white: #ffffff;
    --gray-bg: #f5f6f7;
    --border: #dfe3e6;
    --ink: #1a1f21;
    --ink-muted: #566064;
    --font-display: "Archivo Black", Impact, sans-serif;
    --font-sans: "Inter", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; height: auto; }
  h1, h2, h3, h4, p, dl, dt, dd, ul, figure { margin: 0; }

  .container {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  /* TOPBAR */
  .topbar {
    background: #0c0f0f;
    color: #a8b2ae;
    font-size: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .topbar-inner {
    min-height: 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .topbar-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .topbar a:hover {
    color: var(--orange);
  }
  .topbar-sep {
    color: rgba(255, 255, 255, 0.22);
  }
  .topbar-ext {
    color: #d7dedb;
  }

  /* HEADER */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--dark);
    color: var(--white);
    border-bottom: 1px solid var(--dark-line);
  }
  .header-inner {
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .brand-logo {
    display: block;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }
  .brand-wordmark {
    font-family: var(--font-display);
    font-size: 16px;
    letter-spacing: 1.5px;
    color: var(--white);
  }
  .brand-wordmark span {
    color: var(--orange);
  }
  .brand-sub {
    padding-left: 12px;
    border-left: 1px solid rgba(255, 255, 255, 0.22);
    font-size: 13px;
    font-weight: 500;
    color: #b7c0bc;
  }
  .main-nav {
    display: flex;
    align-items: center;
    gap: 26px;
    font-size: 14px;
    font-weight: 500;
    color: #d6ddda;
  }
  .main-nav a:hover {
    color: var(--orange);
  }
  .header-right {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .menu-btn {
    display: none;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 2px;
    background: transparent;
    color: var(--white);
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
  }
  .menu-btn span {
    width: 16px;
    height: 1.5px;
    background: currentColor;
  }
  .mobile-nav {
    background: var(--dark-2);
    border-top: 1px solid var(--dark-line);
  }
  .mobile-nav-inner {
    display: grid;
    padding-block: 10px 16px;
  }
  .mobile-nav-inner > a {
    padding: 11px 0;
    border-bottom: 1px solid var(--dark-line);
    color: #eef2f0;
    font-size: 15px;
  }
  .mobile-nav-links {
    display: flex;
    gap: 18px;
    padding-top: 14px;
    font-size: 13px;
    color: var(--orange);
  }

  /* HERO */
  .hero {
    background: var(--dark);
    color: var(--white);
    padding: 64px 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 48px;
    align-items: center;
  }
  .hero-company-sub {
    font-size: 13px;
    color: var(--orange);
    font-weight: 600;
    margin-bottom: 10px;
  }
  .hero h1 {
    font-family: var(--font-sans);
    font-size: clamp(1.9rem, 1.1rem + 2.1vw, 2.9rem);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.015em;
    color: var(--white);
  }
  html[lang="en"] .hero h1 {
    font-family: var(--font-display);
    font-weight: 400;
    line-height: 1.12;
  }
  .hero-subtitle {
    margin-top: 12px;
    font-size: 18px;
    font-weight: 600;
    color: #e4eae7;
  }
  .hero-summary {
    margin-top: 18px;
    color: #b4bfbb;
    font-size: 15px;
    line-height: 1.8;
  }
  .hero-actions {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 22px;
    border-radius: 2px;
    font-size: 14px;
    font-weight: 600;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .btn-primary {
    background: var(--orange);
    color: var(--dark);
  }
  .btn-primary:hover {
    background: #ff8c38;
  }
  .btn-outline-light {
    border: 1px solid rgba(255, 255, 255, 0.34);
    color: var(--white);
  }
  .btn-outline-light:hover {
    border-color: var(--orange);
    color: var(--orange);
  }
  .hero-media {
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: #1a2020;
    overflow: hidden;
  }
  .hero-media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* FACTS BAR */
  .facts-bar {
    background: var(--white);
    border-bottom: 1px solid var(--border);
  }
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .fact-item {
    padding: 24px 20px;
    border-right: 1px solid var(--border);
    text-align: center;
  }
  .fact-item:first-child {
    border-left: 1px solid var(--border);
  }
  .fact-item dd {
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.25;
  }
  .fact-item dt {
    margin-top: 6px;
    font-size: 13px;
    color: var(--ink-muted);
  }

  /* SECTIONS */
  .section {
    padding: 72px 0;
    scroll-margin-top: 68px;
  }
  .section-white {
    background: var(--white);
  }
  .section-gray {
    background: var(--gray-bg);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .section-head {
    margin-bottom: 32px;
  }
  .section-head h2 {
    font-size: clamp(1.45rem, 1.1rem + 0.9vw, 1.95rem);
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
    padding-bottom: 12px;
    position: relative;
  }
  html[lang="en"] .section-head h2 {
    font-family: var(--font-display);
    font-weight: 400;
    letter-spacing: -0.01em;
  }
  .section-head h2::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 36px;
    height: 3px;
    background: var(--orange);
  }
  .sub-head {
    margin-top: 48px;
  }
  .section-intro {
    max-width: 780px;
    color: var(--ink-muted);
    margin-bottom: 32px;
    line-height: 1.8;
  }

  /* OVERVIEW */
