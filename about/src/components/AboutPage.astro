---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LocaleHead from "./LocaleHead.astro";
import { localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = translations[locale];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={copy.langAttr}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:url" content={new URL(localizedPath(locale), Astro.site).href} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <title>{copy.title}</title>
    <LocaleHead locale={locale} />
  </head>
  <body>
    <!-- GLOBAL HEADER -->
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="https://scooter.work/" aria-label="Scooter.work">
          <img class="brand-logo" src="/logo.png" alt="Scooter.work" width="34" height="34" />
        </a>

        <nav class="main-nav" aria-label={copy.nav.ariaLabel}>
          <a href="https://scooter.work/">{copy.nav.home}</a>
          <a href="https://scooter.work/#products">{copy.nav.products}</a>
          <a href="https://guides.scooter.work/">{copy.nav.guides}</a>
          <a class="nav-pill" href={localizedPath(locale)} aria-current="page">{copy.nav.aboutSite}</a>
        </nav>

        <a class="header-whatsapp" href="https://wa.me/447873353246" target="_blank" rel="noreferrer">
          <span class="wa-text">
            <small>WhatsApp</small>
            <strong>+44 7873 353246</strong>
          </span>
          <svg viewBox="0 0 1024 1024" width="22" height="22" aria-hidden="true">
            <path d="M713.5 599.9c-10.9-5.6-65.2-32.2-75.3-35.8-10.1-3.8-17.5-5.6-24.8 5.6-7.4 11.1-28.4 35.8-35 43.3-6.4 7.4-12.9 8.3-23.8 2.8-64.8-32.4-107.3-57.8-150-131.1-11.3-19.5 11.3-18.1 32.4-60.2 3.6-7.4 1.8-13.7-1-19.3-2.8-5.6-24.8-59.8-34-81.9-8.9-21.5-18.1-18.5-24.8-18.9-6.4-0.4-13.7-0.4-21.1-0.4-7.4 0-19.3 2.8-29.4 13.7-10.1 11.1-38.6 37.8-38.6 92s39.5 106.7 44.9 114.1c5.6 7.4 77.7 118.6 188.4 166.5 70 30.2 97.4 32.8 132.4 27.6 21.3-3.2 65.2-26.6 74.3-52.5 9.1-25.8 9.1-47.9 6.4-52.5-2.7-4.9-10.1-7.7-21-13z" fill="currentColor" />
            <path d="M925.2 338.4c-22.6-53.7-55-101.9-96.3-143.3-41.3-41.3-89.5-73.8-143.3-96.3C630.6 75.7 572.2 64 512 64h-2c-60.6 0.3-119.3 12.3-174.5 35.9-53.3 22.8-101.1 55.2-142 96.5-40.9 41.3-73 89.3-95.2 142.8-23 55.4-34.6 114.3-34.3 174.9 0.3 69.4 16.9 138.3 48 199.9v152c0 25.4 20.6 46 46 46h152.1c61.6 31.1 130.5 47.7 199.9 48h2.1c59.9 0 118-11.6 172.7-34.3 53.5-22.3 101.6-54.3 142.8-95.2 41.3-40.9 73.8-88.7 96.5-142 23.6-55.2 35.6-113.9 35.9-174.5 0.3-60.9-11.5-120-34.8-175.6z m-151.1 438C704 845.8 611 884 512 884h-1.7c-60.3-0.3-120.2-15.3-173.1-43.5l-8.4-4.5H188V695.2l-4.5-8.4C155.3 633.9 140.3 574 140 513.7c-0.4-99.7 37.7-193.3 107.6-263.8 69.8-70.5 163.1-109.5 262.8-109.9h1.7c50 0 98.5 9.7 144.2 28.9 44.6 18.7 84.6 45.6 119 80 34.3 34.3 61.3 74.4 80 119 19.4 46.2 29.1 95.2 28.9 145.8-0.6 99.6-39.7 192.9-110.1 262.7z" fill="currentColor" />
          </svg>
        </a>

        <div class="header-actions">
          <LanguageSwitcher locale={locale} />
          <a class="store-cta" href="https://scooter.work/#stores">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="20" r="1.5" />
              <circle cx="17" cy="20" r="1.5" />
              <path d="M3 4h2l2.4 10.5a1.5 1.5 0 0 0 1.5 1.2h8.8a1.5 1.5 0 0 0 1.5-1.2L21 7H6" />
            </svg>
            <span>{copy.nav.stores}</span>
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- HERO BANNER -->
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-text">
            <p class="hero-company-sub">{copy.hero.companySub}</p>
            <h1>{copy.hero.companyName}</h1>
            <p class="hero-subtitle">{copy.hero.headline}</p>
            <p class="hero-summary">{copy.hero.summary}</p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#contact">{copy.hero.primaryCta}</a>
              <a class="btn btn-outline" href="https://scooter.work/" target="_blank" rel="noreferrer">
                {copy.hero.secondaryCta} ↗
              </a>
            </div>
          </div>

          <div class="hero-media">
            <img src="/images/company/sign-wide.jpg" alt={copy.hero.signAlt} width="1024" height="576" />
          </div>
        </div>
      </section>

      <!-- KEY FACTS STRIP -->
      <div class="facts-bar">
        <div class="container">
          <dl class="facts-grid">
            {copy.hero.facts.map((item) => (
              <div class="fact-item">
                <dd>{item.value}</dd>
                <dt>{item.label}</dt>
              </div>
            ))}
          </dl>
        </div>
      </div>

      <!-- COMPANY OVERVIEW & ORGANIZATION -->
      <section class="section section-white" id="overview">
        <div class="container">
          <div class="section-head">
            <h2>{copy.overview.title}</h2>
          </div>

          <div class="overview-grid">
            <figure class="overview-photo">
              <img src="/images/company/office-team.jpg" alt={copy.overview.photoAlt} loading="lazy" width="1024" height="575" />
              <figcaption>{copy.overview.photoCaption}</figcaption>
            </figure>

            <div class="overview-org">
              <h3>{copy.overview.departmentsTitle}</h3>
              <dl class="dept-table">
                {copy.overview.departments.map((dept) => (
                  <div class="dept-row">
                    <dt>{dept.name}</dt>
                    <dd>{dept.detail}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </div>
        </div>
      </section>

      <!-- PARTNERS & OWN BRAND -->
      <section class="section section-gray" id="brands">
        <div class="container">
          <div class="section-head">
            <h2>{copy.brands.partnersTitle}</h2>
          </div>

          <div class="partner-grid">
            {copy.brands.partners.map((partner) => (
              <article class="partner-card">
                <div class="partner-logo">
                  <img class={partner.logoClass} src={partner.logo} alt={partner.name} loading="lazy" />
                </div>
                <p>{partner.description}</p>
                <a class="text-link" href={partner.href} target="_blank" rel="noreferrer">
                  {partner.domain} ↗
                </a>
              </article>
            ))}
          </div>

          <div class="section-head sub-head">
            <h2>{copy.brands.ownBrandTitle}</h2>
          </div>

          <article class="own-brand-row">
            <div class="own-brand-logo">
              <img src={copy.brands.ownBrand.logo} alt={copy.brands.ownBrand.name} loading="lazy" />
            </div>
            <div class="own-brand-body">
              <p>{copy.brands.ownBrand.description}</p>
              <a class="text-link" href={copy.brands.ownBrand.href} target="_blank" rel="noreferrer">
                {copy.brands.ownBrand.domain} ↗
              </a>
            </div>
          </article>
        </div>
      </section>

      <!-- CROSS-BORDER OPERATIONS -->
      <section class="section section-white" id="operations">
        <div class="container">
          <div class="section-head">
            <h2>{copy.operations.title}</h2>
          </div>

          <div class="ops-split">
            <div class="ops-text">
              <p class="ops-summary">{copy.operations.summary}</p>
              <dl class="ops-list">
                {copy.operations.points.map((point) => (
                  <div class="ops-item">
                    <dt>{point.title}</dt>
                    <dd>{point.detail}</dd>
                  </div>
                ))}
              </dl>
            </div>

            <figure class="ops-photo">
              <img src="/images/company/shopify-trophy.jpg" alt={copy.operations.trophyAlt} loading="lazy" width="1024" height="576" />
              <figcaption>{copy.operations.trophyCaption}</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <!-- WAREHOUSE, WORKSHOP & R&D -->
      <section class="section section-gray" id="facilities">
        <div class="container">
          <div class="section-head">
            <h2>{copy.facilities.title}</h2>
          </div>

          <div class="photo-grid">
            {copy.facilities.photos.map((photo) => (
              <figure class="photo-card">
                <div class="photo-frame">
                  <img src={photo.src} alt={photo.caption} loading="lazy" width="1024" height="575" />
                </div>
                <figcaption>{photo.caption}</figcaption>
              </figure>
            ))}
          </div>

          <div class="rd-block">
            <h3>{copy.facilities.rdTitle}</h3>
            <div class="rd-grid">
              {copy.facilities.rdItems.map((item) => (
                <figure class="rd-card">
                  <div class="rd-thumb">
                    <img src={item.image} alt={item.name} loading="lazy" />
                  </div>
                  <figcaption>{item.name}</figcaption>
                </figure>
              ))}
            </div>
            <p class="rd-note">
              {copy.facilities.rdNote}{" "}
              <a href="https://scooter.work/" target="_blank" rel="noreferrer">scooter.work ↗</a>
              {" · "}
              <a href="https://guides.scooter.work/" target="_blank" rel="noreferrer">guides.scooter.work ↗</a>
            </p>
          </div>
        </div>
      </section>

      <!-- PARTNERSHIP MODELS -->
      <section class="section section-white" id="partnership">
        <div class="container">
          <div class="section-head">
            <h2>{copy.partnership.title}</h2>
          </div>
          <p class="section-intro">{copy.partnership.summary}</p>

          <div class="coop-grid">
            {copy.partnership.models.map((model) => (
              <article class="coop-card">
                <h3>{model.title}</h3>
                <p>{model.detail}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- CONTACT -->
      <section class="section-contact" id="contact">
        <div class="container contact-grid">
          <div class="contact-info">
            <h2>{copy.contact.title}</h2>
            <p class="contact-company">{copy.contact.company}</p>
            <p class="contact-address">{copy.contact.address}</p>
          </div>

          <div class="contact-channels">
            <div class="channel-row">
              <span class="channel-label">{copy.contact.phoneLabel}</span>
              <a class="channel-val" href="tel:+8615800009272">+86 15800009272</a>
              <button
                class="copy-btn"
                type="button"
                data-copy="+86 15800009272"
                data-label={copy.contact.copy}
                data-copied={copy.contact.copied}
              >
                {copy.contact.copy}
              </button>
            </div>

            <div class="channel-row">
              <span class="channel-label">{copy.contact.emailLabel}</span>
              <a class="channel-val" href="mailto:support@scooter.work">support@scooter.work</a>
              <button
                class="copy-btn"
                type="button"
                data-copy="support@scooter.work"
                data-label={copy.contact.copy}
                data-copied={copy.contact.copied}
              >
                {copy.contact.copy}
              </button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <!-- GLOBAL FOOTER -->
    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="brand" href="https://scooter.work/" aria-label="Scooter.work">
          <img class="brand-logo" src="/logo.png" alt="Scooter.work" width="34" height="34" />
        </a>
        <p>{copy.contact.company}</p>
        <a class="footer-link" href="https://guides.scooter.work/">{copy.nav.guides}</a>
        <a class="footer-link" href="https://scooter.work/">{copy.nav.mainSite}</a>
        <a class="footer-link" href="mailto:support@scooter.work">support@scooter.work</a>
        <a class="footer-link" href="https://wa.me/447873353246" target="_blank" rel="noreferrer">WhatsApp: +44 7873 353246</a>
        <a class="footer-link" href="https://scooter.work/privacy/">{copy.nav.privacy}</a>
        <small>© {year} SCOOTER.WORK</small>
      </div>
    </footer>
  </body>
</html>

<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
    let timer: number | undefined;
    btn.addEventListener("click", async () => {
      const value = btn.dataset.copy;
      if (!value) return;
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = btn.dataset.copied || "Copied";
        btn.classList.add("copied");
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          btn.textContent = btn.dataset.label || "Copy";
          btn.classList.remove("copied");
        }, 1800);
      } catch {}
    });
  });
</script>

<style>
  @font-face { font-family: "Inter"; src: url("/fonts/inter-400.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-500.ttf") format("truetype"); font-style: normal; font-weight: 500; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-600.ttf") format("truetype"); font-style: normal; font-weight: 600; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-700.ttf") format("truetype"); font-style: normal; font-weight: 700; font-display: swap; }

  :root {
    --orange: #f56600;
    --orange-hover: #de5a00;
    --white: #ffffff;
    --gray-bg: #f6f7f9;
    --gray-soft: #f7f8fa;
    --border: #e6e9ee;
    --ink: #111418;
    --ink-muted: #5c646d;
    --font-sans: "Inter", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--white);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 1.65;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  img { display: block; max-width: 100%; height: auto; }
  h1, h2, h3, h4, p, dl, dt, dd, ul, figure { margin: 0; }

  .container {
    width: min(1240px, calc(100% - 48px));
    margin-inline: auto;
  }

  /* GLOBAL HEADER */
  .site-header {
    background: var(--white);
    border-bottom: 1px solid var(--border);
    position: relative;
    z-index: 20;
  }
  .header-inner {
    min-height: 78px;
    padding-block: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand-logo {
    display: block;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }
  .main-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .main-nav a {
    white-space: nowrap;
    transition: color 150ms ease, background 150ms ease;
  }
  .main-nav a:not(.nav-pill):hover {
    color: var(--orange);
  }
  .nav-pill {
    padding: 7px 14px;
    border-radius: 0;
    background: var(--orange);
    color: var(--white);
  }
  .nav-pill:hover {
    background: var(--orange-hover);
  }
  .header-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    color: var(--ink);
    white-space: nowrap;
    transition: color 150ms ease;
  }
  .header-whatsapp:hover {
    color: var(--orange);
  }
  .wa-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-align: right;
  }
  .wa-text small {
    font-size: 10px;
    font-weight: 500;
    color: var(--ink-muted);
  }
  .wa-text strong {
    font-size: 12.5px;
    font-weight: 600;
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .store-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 8px 16px;
    border-radius: 0;
    background: var(--orange);
    color: var(--white);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    transition: background 150ms ease;
  }
  .store-cta:hover {
    background: var(--orange-hover);
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--orange);
    outline-offset: 2px;
  }

  /* HERO */
  .hero {
    background: var(--gray-bg);
    color: var(--ink);
    padding: 56px 0;
    border-bottom: 1px solid var(--border);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 48px;
    align-items: center;
  }
  .hero-company-sub {
    font-size: 13px;
    color: var(--orange);
    font-weight: 600;
    margin-bottom: 10px;
  }
  .hero h1 {
    font-size: clamp(1.9rem, 1.1rem + 2.1vw, 2.9rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .hero-subtitle {
    margin-top: 12px;
    font-size: 18px;
    font-weight: 600;
    color: var(--ink);
  }
  .hero-summary {
    margin-top: 16px;
    color: var(--ink-muted);
    font-size: 15px;
    line-height: 1.8;
  }
  .hero-actions {
    margin-top: 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding: 0 22px;
    border-radius: 0;
    font-size: 14px;
    font-weight: 600;
    transition: background 150ms ease, color 150ms ease, border-color 150ms ease;
  }
  .btn-primary {
    background: var(--orange);
    color: var(--white);
  }
  .btn-primary:hover {
    background: var(--orange-hover);
  }
  .btn-outline {
    background: var(--white);
    border: 1px solid var(--ink);
    color: var(--ink);
  }
  .btn-outline:hover {
    border-color: var(--orange);
    color: var(--orange);
  }
  .hero-media {
    border: 1px solid var(--border);
    background: var(--white);
    overflow: hidden;
  }
  .hero-media img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  /* FACTS BAR */
  .facts-bar {
    background: var(--white);
    border-bottom: 1px solid var(--border);
  }
  .facts-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .fact-item {
    padding: 24px 20px;
    border-right: 1px solid var(--border);
    text-align: center;
  }
  .fact-item:first-child {
    border-left: 1px solid var(--border);
  }
  .fact-item dd {
    font-size: 22px;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.25;
  }
  .fact-item dt {
    margin-top: 6px;
    font-size: 13px;
    color: var(--ink-muted);
  }

  /* SECTIONS */
  .section {
    padding: 68px 0;
    scroll-margin-top: 24px;
  }
  .section-white {
    background: var(--white);
  }
  .section-gray {
    background: var(--gray-bg);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .section-head {
    margin-bottom: 30px;
  }
  .section-head h2 {
    font-size: clamp(1.45rem, 1.1rem + 0.9vw, 1.95rem);
    font-weight: 700;
    color: var(--ink);
    line-height: 1.3;
    letter-spacing: -0.02em;
    padding-bottom: 12px;
    position: relative;
  }
  .section-head h2::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 36px;
    height: 3px;
    background: var(--orange);
  }
  .sub-head {
    margin-top: 48px;
  }
  .section-intro {
    max-width: 780px;
    color: var(--ink-muted);
    margin-bottom: 30px;
    line-height: 1.8;
  }

  /* OVERVIEW */
  .overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 44px;
    align-items: start;
  }
  .overview-photo {
    border: 1px solid var(--border);
    background: var(--gray-bg);
  }
  .overview-photo img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .overview-photo figcaption {
    padding: 10px 14px;
    font-size: 13px;
    color: var(--ink-muted);
    border-top: 1px solid var(--border);
    background: var(--white);
  }
  .overview-org h3 {
    font-size: 17px;
    font-weight: 700;
    margin-bottom: 16px;
    color: var(--ink);
  }
  .dept-table {
