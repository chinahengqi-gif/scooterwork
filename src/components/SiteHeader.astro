---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  active: "home" | "guides" | "privacy";
  variant?: "overlay" | "light";
  page?: string;
  baseUrl?: string;
}

const { locale, active, variant = "light", page = "", baseUrl = "" } = Astro.props;
const copy = translations[locale];
const homeHref = `${baseUrl}${localizedPath(locale)}`;
---

<header class:list={["site-header", `site-header--${variant}`]}>
  <div class="shell header-inner">
    <a class="brand" href={homeHref} aria-label={copy.home}>
      <img class="brand-logo" src="/logo.png" alt="Scooter.work" width="34" height="34" />
    </a>

    <nav class="main-nav" aria-label={copy.navigation}>
      <a class:list={[{ "nav-pill": active === "home" }]} href={homeHref} aria-current={active === "home" ? "page" : undefined}>
        {copy.navHome}
      </a>
      <a href={`${homeHref}#products`}>{copy.navProducts}</a>
      <a
        class:list={[{ "nav-pill": active === "guides" }]}
        href={`https://guides.scooter.work${localizedPath(locale)}`}
        aria-current={active === "guides" ? "page" : undefined}
      >
        {copy.guidesLink}
      </a>
      <a href="https://about.scooter.work/">{copy.navAbout}</a>
    </nav>

    <a class="header-whatsapp" href="https://wa.me/447873353246" target="_blank" rel="noreferrer">
      <span class="wa-text">
        <small>WhatsApp</small>
        <strong>+44 7873 353246</strong>
      </span>
      <svg viewBox="0 0 1024 1024" width="22" height="22" aria-hidden="true">
        <path d="M713.5 599.9c-10.9-5.6-65.2-32.2-75.3-35.8-10.1-3.8-17.5-5.6-24.8 5.6-7.4 11.1-28.4 35.8-35 43.3-6.4 7.4-12.9 8.3-23.8 2.8-64.8-32.4-107.3-57.8-150-131.1-11.3-19.5 11.3-18.1 32.4-60.2 3.6-7.4 1.8-13.7-1-19.3-2.8-5.6-24.8-59.8-34-81.9-8.9-21.5-18.1-18.5-24.8-18.9-6.4-0.4-13.7-0.4-21.1-0.4-7.4 0-19.3 2.8-29.4 13.7-10.1 11.1-38.6 37.8-38.6 92s39.5 106.7 44.9 114.1c5.6 7.4 77.7 118.6 188.4 166.5 70 30.2 97.4 32.8 132.4 27.6 21.3-3.2 65.2-26.6 74.3-52.5 9.1-25.8 9.1-47.9 6.4-52.5-2.7-4.9-10.1-7.7-21-13z" fill="currentColor" />
        <path d="M925.2 338.4c-22.6-53.7-55-101.9-96.3-143.3-41.3-41.3-89.5-73.8-143.3-96.3C630.6 75.7 572.2 64 512 64h-2c-60.6 0.3-119.3 12.3-174.5 35.9-53.3 22.8-101.1 55.2-142 96.5-40.9 41.3-73 89.3-95.2 142.8-23 55.4-34.6 114.3-34.3 174.9 0.3 69.4 16.9 138.3 48 199.9v152c0 25.4 20.6 46 46 46h152.1c61.6 31.1 130.5 47.7 199.9 48h2.1c59.9 0 118-11.6 172.7-34.3 53.5-22.3 101.6-54.3 142.8-95.2 41.3-40.9 73.8-88.7 96.5-142 23.6-55.2 35.6-113.9 35.9-174.5 0.3-60.9-11.5-120-34.8-175.6z m-151.1 438C704 845.8 611 884 512 884h-1.7c-60.3-0.3-120.2-15.3-173.1-43.5l-8.4-4.5H188V695.2l-4.5-8.4C155.3 633.9 140.3 574 140 513.7c-0.4-99.7 37.7-193.3 107.6-263.8 69.8-70.5 163.1-109.5 262.8-109.9h1.7c50 0 98.5 9.7 144.2 28.9 44.6 18.7 84.6 45.6 119 80 34.3 34.3 61.3 74.4 80 119 19.4 46.2 29.1 95.2 28.9 145.8-0.6 99.6-39.7 192.9-110.1 262.7z" fill="currentColor" />
      </svg>
    </a>

    <div class="header-actions">
      <LanguageSwitcher locale={locale} page={page} variant={variant} />
      <a class="store-cta" href={`${homeHref}#stores`}>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="9" cy="20" r="1.5" />
          <circle cx="17" cy="20" r="1.5" />
          <path d="M3 4h2l2.4 10.5a1.5 1.5 0 0 0 1.5 1.2h8.8a1.5 1.5 0 0 0 1.5-1.2L21 7H6" />
        </svg>
        <span>{copy.navStores}</span>
      </a>
    </div>
  </div>
</header>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  .site-header {
    position: relative;
    z-index: 20;
  }
  .site-header--light {
    background: #ffffff;
    border-bottom: 1px solid #e6e9ee;
  }
  .shell {
    width: min(1240px, calc(100% - 48px));
    margin-inline: auto;
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 78px;
    padding-block: 14px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }
  .brand-logo {
    display: block;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }
  .main-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
    font-weight: 600;
  }
  .site-header--overlay .main-nav { color: rgba(255, 255, 255, 0.92); }
  .site-header--light .main-nav { color: #111418; }
  .main-nav a {
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease, background 150ms ease;
  }
  .site-header--overlay .main-nav a:not(.nav-pill) { color: rgba(255, 255, 255, 0.92); }
  .site-header--light .main-nav a:not(.nav-pill) { color: #111418; }
  .site-header--overlay .main-nav a:not(.nav-pill):hover { color: #ff9447; }
  .site-header--light .main-nav a:not(.nav-pill):hover { color: #f56600; }
  .nav-pill {
    padding: 7px 14px;
    border-radius: 0;
    background: #f56600;
    color: #ffffff !important;
  }
  .nav-pill:hover { background: #de5a00; }

  .header-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms ease;
  }
  .site-header--overlay .header-whatsapp { color: rgba(255, 255, 255, 0.94); }
  .site-header--light .header-whatsapp { color: #111418; }
  .site-header--overlay .header-whatsapp:hover { color: #ff9447; }
  .site-header--light .header-whatsapp:hover { color: #f56600; }
  .wa-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-align: right;
  }
  .wa-text small {
    font-size: 10px;
    font-weight: 500;
  }
  .site-header--overlay .wa-text small { color: rgba(255, 255, 255, 0.72); }
  .site-header--light .wa-text small { color: #5c646d; }
  .wa-text strong {
    font-size: 12.5px;
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .store-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 8px 16px;
    border-radius: 0;
    background: #f56600;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    transition: background 150ms ease;
  }
  .store-cta:hover { background: #de5a00; }
  .site-header--overlay a:focus-visible { outline: 2px solid #ffffff; outline-offset: 3px; }
  .site-header--light a:focus-visible { outline: 2px solid #f56600; outline-offset: 3px; }

  @media (max-width: 1099px) {
    .header-whatsapp { display: none; }
  }
  @media (max-width: 780px) {
    .shell { width: min(100% - 32px, 680px); }
    .header-inner {
      flex-wrap: wrap;
      gap: 12px;
      padding-block: 14px;
    }
    .main-nav {
      order: 3;
      width: 100%;
      flex-wrap: wrap;
      gap: 10px 18px;
      padding-top: 8px;
    }
    .site-header--overlay .main-nav { border-top: 1px solid rgba(255, 255, 255, 0.18); }
    .site-header--light .main-nav { border-top: 1px solid #eaedf2; }
  }
</style>
