---
import { locales, localizedPath, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  page?: string;
}

const { locale, page = "" } = Astro.props;
---

<link rel="canonical" href={new URL(localizedPath(locale, page), Astro.site)} />
{locales.map((language) => (
  <link rel="alternate" hreflang={language} href={new URL(localizedPath(language, page), Astro.site)} />
))}
<link rel="alternate" hreflang="x-default" href={new URL(localizedPath("en", page), Astro.site)} />

{locale === "en" && (
  <script is:inline define:vars={{ page }}>
    let preferredLocale;
    try {
      preferredLocale = localStorage.getItem("scooterwork-language");
    } catch {}
    const supportedLocales = ["en", "de", "fr"];
    if (!supportedLocales.includes(preferredLocale)) {
      preferredLocale = (navigator.languages || [navigator.language])
        .map((language) => language.toLowerCase().split("-")[0])
        .find((language) => supportedLocales.includes(language)) || "en";
    }
    if (preferredLocale !== "en") {
      location.replace(`/${preferredLocale}/${page}${location.search}${location.hash}`);
    }
  </script>
)}
