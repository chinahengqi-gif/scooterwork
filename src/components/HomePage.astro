---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LocaleHead from "./LocaleHead.astro";
import { localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = translations[locale];
const products = [
  {
    image: "/images/battery.jpg",
  },
  {
    image: "/images/alarm.jpg",
  },
  {
    image: "/images/damper.webp",
  },
  {
    image: "/images/speed-kit.webp",
  },
].map((product, index) => ({ ...product, ...copy.productDetails[index] }));

const stores = [
  {
    name: "JOFEN SCOOTER",
    href: "https://jofenscooter.com",
    logo: "/images/JOFEN.avif",
  },
  {
    name: "JOYOR PRIME",
    href: "https://joyorprime.com",
    logo: "/images/joyorprime.avif",
  },
].map((store, index) => ({ ...store, description: copy.storeDescriptions[index] }));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={copy.description}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{copy.title}</title>
    <LocaleHead locale={locale} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localizedPath(locale)} aria-label={copy.home}>
        <span>SCOOTER<span>.WORK</span></span>
      </a>
      <nav aria-label={copy.navigation}>
        <a href="#products">{copy.products}</a>
        <a class="nav-button" href="#stores">{copy.exploreStores} <span>↗</span></a>
        <LanguageSwitcher locale={locale} />
      </nav>
    </header>

    <main>
      <section class="hero shell">
        <div class="hero-copy">
          <h1>{copy.heroTitle}<br /><em>{copy.heroAccent}</em></h1>
          <p class="hero-text">
            {copy.heroText}
          </p>
          <div class="hero-contact" aria-label={copy.contact}>
            <div class="contact-options">
              <a href="mailto:support@scooter.work">
                <span>{copy.email}</span>
                <strong>support@scooter.work</strong>
              </a>
              <a href="https://wa.me/447873353246" target="_blank" rel="noreferrer">
                <span>WhatsApp ↗</span>
                <strong>+44 7873 353246</strong>
              </a>
            </div>
            <p class="contact-note">
              {copy.contactNote}{" "}
              <a href="mailto:support@scooter.work">support@scooter.work</a>.
            </p>
          </div>
        </div>
      </section>

      <section class="intro shell">
        <div>
          <h2>{copy.introTitle}<br /><span>{copy.introAccent}</span></h2>
          <p>
            {copy.introText}
          </p>
        </div>
      </section>

      <section class="products shell" id="products">
        {products.map((product) => (
          <article class="product-card">
            <div class="product-image">
              <img src={product.image} alt={product.alt} />
            </div>
            <div class="product-copy">
              <h3>{product.name}</h3>
              <span>{product.description}</span>
            </div>
          </article>
        ))}
      </section>

      <section class="stores" id="stores">
        <div class="shell">
          <h2>{copy.chooseStore}</h2>
          <div class="store-grid">
            {stores.map((store) => (
              <a class="store-card" href={store.href} target="_blank" rel="noreferrer">
                <div class="store-logo">
                  <img src={store.logo} alt={store.name} />
                </div>
                <p>{store.description}</p>
                <strong>{copy.visitStore} <b>↗</b></strong>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="shell">
      <a class="brand" href={localizedPath(locale)} aria-label={copy.home}>
        <span>SCOOTER<span>.WORK</span></span>
      </a>
      <p>{copy.footerText}</p>
      <a class="support-email" href="mailto:support@scooter.work">support@scooter.work</a>
      <a class="footer-link" href="https://wa.me/447873353246" target="_blank" rel="noreferrer">WhatsApp: +44 7873 353246</a>
      <a class="footer-link" href={localizedPath(locale, "privacy/")}>{copy.privacyLink}</a>
      <small>© {new Date().getFullYear()} SCOOTER.WORK</small>
    </footer>

  </body>
</html>

<style>
  @font-face { font-family: "Archivo Black"; src: url("/fonts/archivo-black.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-400.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-500.ttf") format("truetype"); font-style: normal; font-weight: 500; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-600.ttf") format("truetype"); font-style: normal; font-weight: 600; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-700.ttf") format("truetype"); font-style: normal; font-weight: 700; font-display: swap; }

  :root {
    color-scheme: dark;
    --bg: #111515;
    --panel: #1a2020;
    --line: rgba(238, 244, 232, 0.14);
    --text: #edf2e8;
    --muted: #9ca7a2;
    --acid: #ff7a1a;
    --dark: #101414;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Inter", Arial, sans-serif;
  }
  a { color: inherit; text-decoration: none; }
  .shell { width: min(1380px, calc(100% - 48px)); margin-inline: auto; }
  .site-header {
    width: min(1380px, calc(100% - 48px));
    min-height: 78px;
    margin: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--line);
  }
  .brand { display: flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 800; letter-spacing: 2px; }
  .brand span span { color: var(--acid); }
  nav { display: flex; align-items: center; gap: 30px; font-size: 13px; font-weight: 700; }
  nav > a:hover { color: var(--acid); }
  .nav-button { padding: 12px 16px; border: 1px solid var(--line); }
  .nav-button span { color: var(--acid); }
  .hero { display: flex; min-height: 695px; align-items: center; justify-content: center; text-align: center; }
  .hero-copy { display: flex; min-width: 0; flex-direction: column; align-items: center; }
  h1, h2, h3 { margin: 0; }
  h1, h2 { font-family: "Archivo Black", Impact, sans-serif; font-weight: 400; text-transform: uppercase; }
  h1 { max-width: 1100px; margin-top: 22px; font-size: clamp(2.5rem, 1rem + 4.8vw, 5.75rem); line-height: 1.05; letter-spacing: -0.04em; overflow-wrap: anywhere; }
  h1 em { color: var(--acid); font-style: normal; }
  .hero-text { max-width: 620px; margin: 28px 0 0; color: var(--muted); font-size: 16px; line-height: 1.8; }
  .hero-contact { width: min(100%, 620px); margin-top: 35px; }
  .contact-options { display: flex; flex-wrap: wrap; justify-content: center; gap: 20px 40px; }
  .contact-options a { display: grid; gap: 8px; padding: 8px 0; min-width: 0; overflow-wrap: anywhere; }
  .contact-options a:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .contact-options span { color: var(--muted); font-size: 12px; letter-spacing: 1px; text-transform: uppercase; }
  .contact-options strong { color: var(--acid); font-size: 16px; }
  .contact-note { margin: 20px 0 0; color: var(--muted); font-size: 13px; line-height: 1.8; }
  .contact-note a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; overflow-wrap: anywhere; }
  .contact-options a:focus-visible, .contact-note a:focus-visible { outline: 2px solid var(--acid); outline-offset: 4px; }
  .intro { padding: 115px 0 50px; border-top: 1px solid var(--line); }
  h2 { font-size: clamp(2rem, 1rem + 4vw, 4.2rem); line-height: 1.1; letter-spacing: -0.03em; overflow-wrap: anywhere; }
  h2 span { color: var(--acid); }
  .intro div p { max-width: 720px; margin-top: 22px; color: var(--muted); font-size: 16px; line-height: 1.8; }
  .products { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; padding-bottom: 125px; }
  .product-card { display: flex; overflow: hidden; flex-direction: column; background: var(--panel); border: 1px solid var(--line); transition: border-color 180ms ease; }
  .product-card:hover { border-color: rgba(255, 122, 26, 0.45); }
  .product-image { overflow: hidden; }
  .product-image img { display: block; width: 100%; }
  .product-copy { flex: 1; padding: 24px; background: var(--acid); color: #fff; }
  h3 { font-size: 22px; letter-spacing: -0.7px; overflow-wrap: anywhere; }
  .product-copy > span { display: block; margin-top: 12px; color: rgba(255, 255, 255, 0.82); font-size: 14px; line-height: 1.7; }
  .stores { padding: 112px 0 125px; background: #e6ebdf; color: var(--dark); }
  .stores h2 { margin: 0 0 38px; }
  .store-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 15px; }
  .store-card { padding: 34px; background: #f5f7f0; border: 1px solid rgba(16, 20, 20, 0.12); transition: background 180ms ease; }
  .store-card:hover { background: var(--acid); }
  .store-card:hover p { color: #fff; }
  .store-logo { display: flex; min-height: 70px; align-items: center; margin-bottom: 18px; }
  .store-logo img { display: block; max-width: min(100%, 310px); max-height: 70px; object-fit: contain; object-position: left center; }
  .store-card p { min-height: 48px; color: #67706c; font-size: 14px; line-height: 1.7; }
  .store-card strong { display: block; margin-top: 28px; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; }
  .store-card b { float: right; font-size: 18px; }
  footer { display: flex; flex-wrap: wrap; gap: 20px 28px; align-items: center; min-height: 114px; padding-block: 24px; }
  footer p, footer small, .support-email, .footer-link { color: var(--muted); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; }
  .support-email:hover, .footer-link:hover { color: var(--acid); }
  @media (max-width: 820px) {
    .shell, .site-header { width: min(100% - 30px, 680px); }
    .site-header { flex-wrap: wrap; gap: 12px; padding-block: 16px; }
    nav { flex-wrap: wrap; gap: 12px 20px; }
    nav > a:not(.nav-button) { display: none; }
    .hero { min-height: auto; padding: 76px 0 82px; }
    h1 { font-size: clamp(2.25rem, 1rem + 6.5vw, 4.5rem); }
    .intro { padding: 88px 0 35px; }
    .products { grid-template-columns: 1fr; padding-bottom: 88px; }
    .stores { padding: 82px 0; }
    .store-grid { grid-template-columns: 1fr; }
    footer { display: flex; min-height: auto; flex-wrap: wrap; gap: 6px 20px; padding: 28px 0; }
    footer .brand { width: 100%; margin-bottom: 8px; }
    footer p, footer small { margin: 0; }
  }
</style>
