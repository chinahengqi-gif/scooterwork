---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LocaleHead from "./LocaleHead.astro";
import RecentArticles from "./RecentArticles.astro";
import { localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = translations[locale];
const products = [
  {
    image: "/images/battery.jpg",
  },
  {
    image: "/images/alarm.jpg",
  },
  {
    image: "/images/damper.webp",
  },
  {
    image: "/images/speed-kit.webp",
  },
  {
    image: "/images/scooter-trailer.jpg",
  },
].map((product, index) => ({
  ...product,
  ...copy.productDetails[index],
  guideUrl: `https://guides.scooter.work${localizedPath(locale, `products/${["battery", "alarm", "damper", "speed-kit", "scooter-trailer"][index]}/`)}`,
})).filter((_, index) => index !== 0);

const stores = [
  {
    name: "JOFEN SCOOTER",
    href: "https://jofenscooter.com",
    logo: "/images/JOFEN.avif",
  },
  {
    name: "JOYOR PRIME",
    href: "https://joyorprime.com",
    logo: "/images/joyorprime.avif",
  },
  {
    name: "NAVEE",
    href: "https://naveescooter.com",
    logo: "/images/navee.svg",
  },
  {
    name: "KUKIRIN PRIME",
    href: "https://kukirinprime.com",
    logo: "/images/kukirin-prime.webp",
  },
].map((store, index) => ({ ...store, description: copy.storeDescriptions[index] }));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={copy.description}
    />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <title>{copy.title}</title>
    <LocaleHead locale={locale} />
  </head>
  <body>
    <div class="hero-stage">
      <header class="site-header shell">
        <a class="brand brand--light" href={localizedPath(locale)} aria-label={copy.home}>
          <img class="brand-logo" src="/logo.png" alt="Scooter.work" width="34" height="34" />
        </a>

        <nav class="main-nav" aria-label={copy.navigation}>
          <a class="nav-pill" href={localizedPath(locale)} aria-current="page">{copy.navHome}</a>
          <a href="#products">{copy.navProducts}</a>
          <a href={`https://guides.scooter.work${localizedPath(locale)}`}>{copy.guidesLink}</a>
        </nav>

        <a class="header-whatsapp" href="https://wa.me/447873353246" target="_blank" rel="noreferrer">
          <span class="wa-text">
            <small>WhatsApp</small>
            <strong>+44 7873 353246</strong>
          </span>
          <svg viewBox="0 0 1024 1024" width="22" height="22" aria-hidden="true">
            <path d="M713.5 599.9c-10.9-5.6-65.2-32.2-75.3-35.8-10.1-3.8-17.5-5.6-24.8 5.6-7.4 11.1-28.4 35.8-35 43.3-6.4 7.4-12.9 8.3-23.8 2.8-64.8-32.4-107.3-57.8-150-131.1-11.3-19.5 11.3-18.1 32.4-60.2 3.6-7.4 1.8-13.7-1-19.3-2.8-5.6-24.8-59.8-34-81.9-8.9-21.5-18.1-18.5-24.8-18.9-6.4-0.4-13.7-0.4-21.1-0.4-7.4 0-19.3 2.8-29.4 13.7-10.1 11.1-38.6 37.8-38.6 92s39.5 106.7 44.9 114.1c5.6 7.4 77.7 118.6 188.4 166.5 70 30.2 97.4 32.8 132.4 27.6 21.3-3.2 65.2-26.6 74.3-52.5 9.1-25.8 9.1-47.9 6.4-52.5-2.7-4.9-10.1-7.7-21-13z" fill="currentColor" />
            <path d="M925.2 338.4c-22.6-53.7-55-101.9-96.3-143.3-41.3-41.3-89.5-73.8-143.3-96.3C630.6 75.7 572.2 64 512 64h-2c-60.6 0.3-119.3 12.3-174.5 35.9-53.3 22.8-101.1 55.2-142 96.5-40.9 41.3-73 89.3-95.2 142.8-23 55.4-34.6 114.3-34.3 174.9 0.3 69.4 16.9 138.3 48 199.9v152c0 25.4 20.6 46 46 46h152.1c61.6 31.1 130.5 47.7 199.9 48h2.1c59.9 0 118-11.6 172.7-34.3 53.5-22.3 101.6-54.3 142.8-95.2 41.3-40.9 73.8-88.7 96.5-142 23.6-55.2 35.6-113.9 35.9-174.5 0.3-60.9-11.5-120-34.8-175.6z m-151.1 438C704 845.8 611 884 512 884h-1.7c-60.3-0.3-120.2-15.3-173.1-43.5l-8.4-4.5H188V695.2l-4.5-8.4C155.3 633.9 140.3 574 140 513.7c-0.4-99.7 37.7-193.3 107.6-263.8 69.8-70.5 163.1-109.5 262.8-109.9h1.7c50 0 98.5 9.7 144.2 28.9 44.6 18.7 84.6 45.6 119 80 34.3 34.3 61.3 74.4 80 119 19.4 46.2 29.1 95.2 28.9 145.8-0.6 99.6-39.7 192.9-110.1 262.7z" fill="currentColor" />
          </svg>
        </a>

        <div class="header-actions">
          <LanguageSwitcher locale={locale} variant="overlay" />
          <a class="store-cta" href="#stores">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="9" cy="20" r="1.5" />
              <circle cx="17" cy="20" r="1.5" />
              <path d="M3 4h2l2.4 10.5a1.5 1.5 0 0 0 1.5 1.2h8.8a1.5 1.5 0 0 0 1.5-1.2L21 7H6" />
            </svg>
            <span>{copy.navStores}</span>
          </a>
        </div>
      </header>

      <section class="hero shell" aria-label={copy.contact}>
        <div class="hero-copy">
          <h1>{copy.heroTitle} {copy.heroAccent}</h1>
          <div class="hero-ctas">
            <a class="hero-btn hero-btn--primary" href="mailto:support@scooter.work">
              {copy.email}: support@scooter.work
            </a>
            <a class="hero-btn hero-btn--ghost" href="https://wa.me/447873353246" target="_blank" rel="noreferrer">
              WhatsApp: +44 7873 353246 ↗
            </a>
          </div>
        </div>
      </section>
    </div>

    <div class="support-bar">
      <div class="shell">
        <p class="contact-note">
          {copy.contactNote}{" "}
          <a href="mailto:support@scooter.work">support@scooter.work</a>. {copy.orderNote}
        </p>
      </div>
    </div>

    <main>
      <section class="intro shell">
        <div>
          <h2>{copy.introTitle} <span>{copy.introAccent}</span></h2>
        </div>
      </section>

      <section class="products shell" id="products" data-locale={locale}>
        {products.map((product) => (
          <article class="product-card">
            <div class="product-image">
              <img src={product.image} alt={product.alt} />
            </div>
            <div class="product-copy">
              <h3>{product.name}</h3>
              <span>{product.description}</span>
              <a class="product-guide" href={product.guideUrl}>{copy.guidesLink} ↗</a>
            </div>
          </article>
        ))}
      </section>

      <div class="shell">
        <RecentArticles locale={locale} />
      </div>

      <section class="stores" id="stores">
        <div class="shell">
          <h2>{copy.chooseStore}</h2>
          <div class="store-grid">
            {stores.map((store) => (
              <a class="store-card" href={store.href} target="_blank" rel="noreferrer">
                <div class="store-logo">
                  <img src={store.logo} alt={store.name} />
                </div>
                <p>{store.description}</p>
                <strong>{copy.visitStore} <span aria-hidden="true">↗</span></strong>
              </a>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="brand brand--dark" href={localizedPath(locale)} aria-label={copy.home}>
          <img class="brand-logo" src="/logo.png" alt="Scooter.work" width="34" height="34" />
        </a>
        <p>{copy.footerText}</p>
        <a class="footer-link" href="mailto:support@scooter.work">support@scooter.work</a>
        <a class="footer-link" href="https://wa.me/447873353246" target="_blank" rel="noreferrer">WhatsApp: +44 7873 353246</a>
        <a class="footer-link" href={localizedPath(locale, "privacy/")}>{copy.privacyLink}</a>
        <small>© {new Date().getFullYear()} SCOOTER.WORK</small>
      </div>
    </footer>

  </body>
</html>

<script>
  const grid = document.querySelector<HTMLElement>("#products");
  const prototype = grid?.querySelector<HTMLElement>(".product-card")?.cloneNode(true) as HTMLElement | undefined;
  if (grid && prototype) {
    const locale = grid.dataset.locale || "en";
    fetch(`https://guides.scooter.work/api/product-categories?locale=${encodeURIComponent(locale)}`)
      .then(response => {
        if (!response.ok) throw new Error("Categories unavailable");
        return response.json();
      })
      .then(payload => {
        if (!Array.isArray(payload.products)) throw new Error("Invalid categories");
        const cards = payload.products.map((product: Record<string, unknown>) => {
          if (typeof product.slug !== "string" || !product.slug || typeof product.name !== "string" || typeof product.description !== "string" || typeof product.image !== "string" || typeof product.alt !== "string") throw new Error("Invalid category");
          const imageUrl = product.image ? new URL(product.image) : null;
          if (imageUrl && imageUrl.protocol !== "https:") throw new Error("Invalid image");
          const card = prototype.cloneNode(true) as HTMLElement;
          card.querySelector("h3")!.textContent = product.name;
          card.querySelector(".product-copy > span")!.textContent = product.description;
          const image = card.querySelector("img")!;
          if (imageUrl) image.src = imageUrl.href;
          else image.removeAttribute("src");
          image.alt = product.alt;
          image.hidden = !imageUrl;
          image.loading = "lazy";
          const prefix = locale === "en" ? "" : `/${locale}`;
          card.querySelector<HTMLAnchorElement>(".product-guide")!.href = `https://guides.scooter.work${prefix}/products/${encodeURIComponent(product.slug)}/`;
          return card;
        });
        grid.replaceChildren(...cards);
      })
      .catch(() => {});
  }
</script>

<style>
  @font-face { font-family: "Archivo Black"; src: url("/fonts/archivo-black.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-400.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-500.ttf") format("truetype"); font-style: normal; font-weight: 500; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-600.ttf") format("truetype"); font-style: normal; font-weight: 600; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-700.ttf") format("truetype"); font-style: normal; font-weight: 700; font-display: swap; }

  :root {
    --bg: #ffffff;
    --surface: #f6f7f9;
    --surface-soft: #f7f8fa;
    --line: #e6e9ee;
    --line-soft: #eaedf2;
    --text: #111418;
    --muted: #5c646d;
    --accent: #f56600;
    --accent-hover: #de5a00;
    --accent-tint: #fff4ec;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: "Inter", Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, p { margin: 0; }
  .shell { width: min(1240px, calc(100% - 48px)); margin-inline: auto; }

  /* HERO STAGE (PHOTO + OVERLAID HEADER) */
  .hero-stage {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 540px;
    background-color: #1c2833;
    background-image:
      linear-gradient(180deg, rgba(14, 22, 30, 0.62) 0%, rgba(14, 22, 30, 0.34) 44%, rgba(14, 22, 30, 0.58) 100%),
      url("/images/hero-scooter.jpg");
    background-size: cover;
    background-position: center 62%;
    color: #ffffff;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    min-height: 78px;
    padding-block: 14px;
    position: relative;
    z-index: 20;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: "Archivo Black", Impact, sans-serif;
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 1.5px;
    flex-shrink: 0;
  }
  .brand-logo {
    display: block;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
  }
  .brand--light { color: #ffffff; }
  .brand--light span span { color: #ff7a1a; }
  .brand--dark { color: var(--text); }
  .brand--dark span span { color: var(--accent); }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 14px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.92);
  }
  .main-nav a {
    transition: color 150ms ease, background 150ms ease;
    white-space: nowrap;
  }
  .main-nav a:not(.nav-pill):hover { color: #ff9447; }
  .nav-pill {
    padding: 7px 14px;
    border-radius: 0;
    background: var(--accent);
    color: #ffffff;
  }
  .nav-pill:hover { background: var(--accent-hover); }

  .header-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
    color: rgba(255, 255, 255, 0.94);
    transition: color 150ms ease;
    white-space: nowrap;
  }
  .header-whatsapp:hover { color: #ff9447; }
  .wa-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-align: right;
  }
  .wa-text small {
    font-size: 10px;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.72);
  }
  .wa-text strong {
    font-size: 12.5px;
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .store-cta {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 8px 16px;
    border-radius: 0;
    background: var(--accent);
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
    transition: background 150ms ease;
  }
  .store-cta:hover { background: var(--accent-hover); }
  .store-cta:focus-visible,
  .main-nav a:focus-visible,
  .header-whatsapp:focus-visible,
  .hero-btn:focus-visible,
  .product-guide:focus-visible,
  .store-card:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .hero {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 40px 0 88px;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 860px;
    min-width: 0;
  }
  h1 {
    font-size: clamp(2.15rem, 1.35rem + 3vw, 3.65rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: #ffffff;
    text-shadow: 0 2px 18px rgba(10, 16, 24, 0.45);
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 26px;
  }
  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 10px 22px;
    border-radius: 0;
    font-size: 14px;
    font-weight: 600;
    transition: background 150ms ease, border-color 150ms ease;
  }
  .hero-btn--primary {
    background: var(--accent);
    border: 1.5px solid var(--accent);
    color: #ffffff;
  }
  .hero-btn--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
  }
  .hero-btn--ghost {
    border: 1.5px solid #ffffff;
    background: rgba(15, 23, 32, 0.34);
    backdrop-filter: blur(4px);
    color: #ffffff;
  }
  .hero-btn--ghost:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  /* SUPPORT BAR */
  .support-bar {
    background: var(--surface-soft);
    border-bottom: 1px solid var(--line-soft);
    padding: 13px 0;
  }
  .contact-note {
    max-width: 920px;
    margin-inline: auto;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.65;
    text-align: center;
    text-wrap: balance;
  }
  .contact-note a {
    color: var(--accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* INTRO */
  .intro {
    padding: 56px 0 28px;
  }
  h2 {
    font-size: clamp(1.65rem, 1.2rem + 1.6vw, 2.35rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  h2 span { color: var(--accent); }

  /* PRODUCT CARDS */
  .products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    padding-bottom: 64px;
  }
  .product-card {
    position: relative;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--line-soft);
    border-radius: 0;
    transition: border-color 180ms ease;
  }
  .product-card:hover {
    border-color: rgba(245, 102, 0, 0.55);
  }
  .product-image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #ffffff;
    padding: 14px;
    border-bottom: 1px solid #f0f2f5;
  }
  .product-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .product-image img[hidden] { display: none; }
  .product-copy {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 14px;
    padding: 18px 20px 20px;
    background: #ffffff;
  }
  h3 {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--text);
    overflow-wrap: anywhere;
  }
  .product-copy > span {
    display: block;
    flex: 1;
    background: var(--surface-soft);
    border-radius: 0;
    padding: 12px 14px;
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.6;
  }
  .product-guide {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 40px;
    padding: 10px 16px;
    border-radius: 0;
    background: var(--accent);
    color: #ffffff;
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
    transition: background 150ms ease;
  }
  .product-guide::after { content: ""; position: absolute; inset: 0; }
  .product-card:hover .product-guide,
  .product-guide:hover { background: var(--accent-hover); }
  .product-guide:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; }

  /* STORES */
  .stores {
    padding: 72px 0 80px;
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
  .stores h2 { margin: 0 0 28px; }
  .store-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }
  .store-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 28px 30px;
    background: #ffffff;
    border: 1px solid var(--line);
    border-radius: 0;
    transition: border-color 180ms ease;
  }
  .store-card:hover {
    border-color: rgba(245, 102, 0, 0.55);
  }
  .store-card:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .store-logo {
    display: flex;
    height: 84px;
    align-items: center;
    margin-bottom: 14px;
  }
  .store-logo img {
    display: block;
    max-width: min(100%, 260px);
    max-height: 76px;
    object-fit: contain;
    object-position: left center;
  }
  .store-card p {
    flex: 1;
    color: var(--muted);
    font-size: 14.5px;
    line-height: 1.65;
  }
  .store-card strong {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 9px 16px;
    border: 1px solid var(--accent);
    border-radius: 0;
    background: var(--accent-tint);
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    transition: background 150ms ease, color 150ms ease;
  }
  .store-card:hover strong {
    background: var(--accent);
    color: #ffffff;
  }

  /* FOOTER */
  .site-footer {
    background: #ffffff;
    border-top: 1px solid var(--line);
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 28px;
    align-items: center;
    min-height: 92px;
    padding-block: 24px;
  }
  .footer-inner p,
  .footer-inner small,
  .footer-link {
    color: var(--muted);
    font-size: 12.5px;
    font-weight: 500;
  }
  .footer-inner small { margin-left: auto; }
  .footer-link:hover { color: var(--accent); }

  @media (max-width: 1099px) {
    .header-whatsapp { display: none; }
    .products { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 780px) {
