---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LocaleHead from "./LocaleHead.astro";
import { localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = translations[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content={copy.privacyDescription}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{copy.privacyTitle}</title>
    <LocaleHead locale={locale} page="privacy/" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={localizedPath(locale)} aria-label={copy.home}>
        <span>SCOOTER<span>.WORK</span></span>
      </a>
      <div class="header-actions">
        <a class="back-link" href={localizedPath(locale)}>{copy.backHome}</a>
        <LanguageSwitcher locale={locale} page="privacy/" />
      </div>
    </header>

    <main class="shell">
      <section class="privacy">
        <h1>{copy.privacyHeading}{locale === "de" ? <wbr /> : " "}<em>{copy.privacyAccent}</em></h1>
        <p class="effective-date">{copy.effectiveDate}</p>

        <div class="policy-grid">
          {copy.policySections.map((section) => (
            <section>
              <h2>{section.title}</h2>
              <p>{section.text}</p>
            </section>
          ))}

          <section>
            <h2>{copy.policyContact}</h2>
            <p>
              {copy.policyContactText}{" "}
              <a href="mailto:support@scooter.work">support@scooter.work</a>.
            </p>
          </section>
        </div>
      </section>
    </main>

    <footer class="shell">
      <a class="brand" href={localizedPath(locale)} aria-label={copy.home}>
        <span>SCOOTER<span>.WORK</span></span>
      </a>
      <small>© {new Date().getFullYear()} SCOOTER.WORK</small>
    </footer>
  </body>
</html>

<style>
  @font-face { font-family: "Archivo Black"; src: url("/fonts/archivo-black.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-400.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-700.ttf") format("truetype"); font-style: normal; font-weight: 700; font-display: swap; }

  :root {
    color-scheme: dark;
    --bg: #111515;
    --panel: #1a2020;
    --line: rgba(238, 244, 232, 0.14);
    --text: #edf2e8;
    --muted: #9ca7a2;
    --acid: #ff7a1a;
  }

  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--text); font-family: "Inter", Arial, sans-serif; }
  a { color: inherit; text-decoration: none; }
  .shell, .site-header { width: min(1380px, calc(100% - 48px)); margin-inline: auto; }
  .site-header { display: flex; min-height: 78px; align-items: center; justify-content: space-between; border-bottom: 1px solid var(--line); }
  .header-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; }
  .brand { font-family: "Archivo Black", Impact, sans-serif; font-size: 15px; font-weight: 400; letter-spacing: 2px; }
  .brand span span { color: var(--acid); }
  .back-link { color: var(--muted); font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; }
  .back-link:hover, .policy-grid a:hover { color: var(--acid); }
  .privacy { padding: 112px 0 126px; }
  h1, h2, p { margin: 0; }
  h1 { font-family: "Archivo Black", Impact, sans-serif; font-size: clamp(2.25rem, 1rem + 7vw, 7.875rem); font-weight: 400; letter-spacing: -0.03em; line-height: 1.05; text-transform: uppercase; overflow-wrap: anywhere; }
  h1 em { color: var(--acid); font-style: normal; }
  .effective-date { margin-top: 24px; color: var(--muted); font-size: 13px; letter-spacing: 1px; text-transform: uppercase; }
  .policy-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1px; margin-top: 74px; background: var(--line); border: 1px solid var(--line); }
  .policy-grid section { min-height: 220px; padding: 30px; background: var(--panel); }
  h2 { color: var(--acid); font-size: 18px; letter-spacing: 0.5px; text-transform: uppercase; }
  .policy-grid p { max-width: 640px; margin-top: 18px; color: var(--muted); font-size: 15px; line-height: 1.8; }
  .policy-grid a { color: var(--text); }
  footer { display: flex; min-height: 114px; align-items: center; justify-content: space-between; border-top: 1px solid var(--line); }
  footer small { color: var(--muted); font-size: 11px; letter-spacing: 1px; text-transform: uppercase; }
  @media (max-width: 820px) {
    .shell, .site-header { width: min(100% - 30px, 680px); }
    .site-header { flex-wrap: wrap; gap: 16px; padding-block: 16px; }
    .privacy { padding: 82px 0; }
    .policy-grid { grid-template-columns: 1fr; margin-top: 52px; }
    .policy-grid section { min-height: auto; padding: 24px; }
  }
</style>
