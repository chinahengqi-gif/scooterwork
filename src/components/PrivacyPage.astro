---
import LanguageSwitcher from "./LanguageSwitcher.astro";
import LocaleHead from "./LocaleHead.astro";
import { localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = translations[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content={copy.privacyDescription}
    />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <title>{copy.privacyTitle}</title>
    <LocaleHead locale={locale} page="privacy/" />
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={localizedPath(locale)} aria-label={copy.home}>
          <img class="brand-logo" src="/logo.png" alt="Scooter.work" width="34" height="34" />
        </a>
        <div class="header-actions">
          <a class="back-link" href={localizedPath(locale)}>{copy.backHome}</a>
          <LanguageSwitcher locale={locale} page="privacy/" variant="light" />
        </div>
      </div>
    </header>

    <main class="shell">
      <section class="privacy">
        <h1>{copy.privacyHeading}{locale === "de" ? <wbr /> : " "}<em>{copy.privacyAccent}</em></h1>
        <p class="effective-date">{copy.effectiveDate}</p>

        <div class="policy-grid">
          {copy.policySections.map((section) => (
            <section class="policy-card">
              <h2>{section.title}</h2>
              <p>{section.text}</p>
            </section>
          ))}

          <section class="policy-card">
            <h2>{copy.policyContact}</h2>
            <p>
              {copy.policyContactText}{" "}
              <a href="mailto:support@scooter.work">support@scooter.work</a>.
            </p>
          </section>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="shell footer-inner">
        <a class="brand" href={localizedPath(locale)} aria-label={copy.home}>
          <img class="brand-logo" src="/logo.png" alt="Scooter.work" width="34" height="34" />
        </a>
        <small>© {new Date().getFullYear()} SCOOTER.WORK</small>
      </div>
    </footer>
  </body>
</html>

<style>
  @font-face { font-family: "Archivo Black"; src: url("/fonts/archivo-black.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-400.ttf") format("truetype"); font-style: normal; font-weight: 400; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-500.ttf") format("truetype"); font-style: normal; font-weight: 500; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-600.ttf") format("truetype"); font-style: normal; font-weight: 600; font-display: swap; }
  @font-face { font-family: "Inter"; src: url("/fonts/inter-700.ttf") format("truetype"); font-style: normal; font-weight: 700; font-display: swap; }

  :root {
    --bg: #ffffff;
    --panel: #f7f8fa;
    --line: #e6e9ee;
    --text: #111418;
    --muted: #5c646d;
    --accent: #f56600;
  }

  * { box-sizing: border-box; }
  body { margin: 0; min-height: 100dvh; display: flex; flex-direction: column; background: var(--bg); color: var(--text); font-family: "Inter", Arial, sans-serif; -webkit-font-smoothing: antialiased; }
  main { flex: 1; }
  a { color: inherit; text-decoration: none; }
  .shell { width: min(1240px, calc(100% - 48px)); margin-inline: auto; }
  .site-header { background: #ffffff; border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; min-height: 74px; align-items: center; justify-content: space-between; gap: 16px; }
  .header-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; font-family: "Archivo Black", Impact, sans-serif; font-size: 16px; font-weight: 400; letter-spacing: 1.5px; color: var(--text); }
  .brand-logo { display: block; width: 34px; height: 34px; flex-shrink: 0; }
  .brand span span { color: var(--accent); }
  .back-link { color: var(--muted); font-size: 13px; font-weight: 600; transition: color 150ms ease; }
  .back-link:hover, .policy-grid a:hover { color: var(--accent); }
  .privacy { padding: 68px 0 88px; }
  h1, h2, p { margin: 0; }
  h1 { font-size: clamp(2.2rem, 1.3rem + 3vw, 3.6rem); font-weight: 700; letter-spacing: -0.025em; line-height: 1.12; color: var(--text); overflow-wrap: anywhere; }
  h1 em { color: var(--accent); font-style: normal; }
  .effective-date { margin-top: 14px; color: var(--muted); font-size: 13px; font-weight: 500; }
  .policy-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; margin-top: 40px; }
  .policy-card { padding: 28px; background: var(--panel); border: 1px solid var(--line); border-radius: 0; }
  h2 { color: var(--text); font-size: 18px; font-weight: 700; letter-spacing: -0.01em; }
  .policy-card p { max-width: 640px; margin-top: 12px; color: var(--muted); font-size: 15px; line-height: 1.75; }
  .policy-card a { color: var(--accent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .site-footer { border-top: 1px solid var(--line); background: #ffffff; }
  .footer-inner { display: flex; min-height: 88px; align-items: center; justify-content: space-between; gap: 16px; }
  footer small { color: var(--muted); font-size: 12px; font-weight: 500; }
  @media (max-width: 820px) {
    .shell { width: min(100% - 32px, 680px); }
    .header-inner { flex-wrap: wrap; padding-block: 14px; }
    .privacy { padding: 48px 0 64px; }
    .policy-grid { grid-template-columns: 1fr; margin-top: 28px; }
    .policy-card { padding: 22px; }
    .footer-inner { flex-direction: column; align-items: flex-start; padding-block: 22px; }
  }
</style>
