---
import { locales, localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  page?: string;
}

const { locale, page = "" } = Astro.props;
const languageNames = { en: "English", de: "Deutsch", fr: "Français" };
---

<div class="language-switcher" role="group" aria-label={translations[locale].language}>
  {locales.map((language) => (
    <a href={localizedPath(language, page)} lang={language} hreflang={language} data-locale={language} aria-current={language === locale ? "page" : undefined}>
      {languageNames[language]}
    </a>
  ))}
</div>

<script>
  document.querySelectorAll<HTMLAnchorElement>(".language-switcher a").forEach((link) => {
    link.addEventListener("click", () => {
      try {
        localStorage.setItem("scooterwork-language", link.dataset.locale!);
      } catch {}
    });
  });
</script>

<style>
  .language-switcher { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 14px; font-size: 12px; font-weight: 600; }
  a { padding-block: 10px; color: var(--muted); text-decoration: none; }
  a:hover, a[aria-current="page"] { color: var(--acid); }
  a[aria-current="page"] { text-decoration: underline; text-underline-offset: 5px; }
  a:focus-visible { outline: 2px solid var(--acid); outline-offset: 4px; }
</style>
