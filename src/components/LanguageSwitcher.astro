---
import { locales, localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  page?: string;
}

const { locale, page = "" } = Astro.props;
const languageNames = { en: "English", de: "Deutsch", fr: "Français" };
---

<div class="language-switcher">
  <button class="language-trigger" type="button" aria-label={`${translations[locale].language}: ${languageNames[locale]}`} aria-expanded="false" aria-controls="language-options">
    <span lang={locale}>{languageNames[locale]}</span>
    <span class="language-arrow" aria-hidden="true"></span>
  </button>
  <ul class="language-options" id="language-options" aria-label={translations[locale].language} hidden>
    {locales.map((language) => (
      <li>
        <a href={localizedPath(language, page)} lang={language} hreflang={language} data-locale={language} aria-current={language === locale ? "page" : undefined}>
          {languageNames[language]}
          {language === locale && <span aria-hidden="true">✓</span>}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".language-switcher").forEach((switcher) => {
    const trigger = switcher.querySelector<HTMLButtonElement>(".language-trigger")!;
    const options = switcher.querySelector<HTMLUListElement>(".language-options")!;
    const links = Array.from(options.querySelectorAll<HTMLAnchorElement>("a"));

    function setOpen(open: boolean) {
      options.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
    }

    trigger.addEventListener("click", () => setOpen(options.hidden));
    trigger.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      event.preventDefault();
      setOpen(true);
      links[event.key === "ArrowDown" ? 0 : links.length - 1].focus();
    });
    switcher.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !options.hidden) {
        event.preventDefault();
        setOpen(false);
        trigger.focus();
      }
    });
    options.addEventListener("keydown", (event) => {
      const current = links.indexOf(document.activeElement as HTMLAnchorElement);
      let next = current;
      if (event.key === "ArrowDown") next = (current + 1) % links.length;
      else if (event.key === "ArrowUp") next = (current - 1 + links.length) % links.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = links.length - 1;
      else return;
      event.preventDefault();
      links[next].focus();
    });
    document.addEventListener("click", (event) => {
      if (!switcher.contains(event.target as Node)) setOpen(false);
    });
    switcher.addEventListener("focusout", (event) => {
      if (!switcher.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    links.forEach((link) => {
      link.addEventListener("click", () => {
        try {
          localStorage.setItem("scooterwork-language", link.dataset.locale!);
        } catch {}
      });
    });
  });
</script>

<style>
  .language-switcher { position: relative; display: inline-flex; font-size: 13px; font-weight: 600; }
  .language-trigger { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-width: 140px; min-height: 44px; padding: 12px 18px; border: 1px solid var(--line); border-radius: 0; outline: none; background: var(--bg); color: var(--text); font: inherit; cursor: pointer; }
  .language-trigger:hover, .language-trigger:focus-visible, .language-trigger[aria-expanded="true"] { border-color: var(--acid); }
  .language-arrow { width: 8px; height: 8px; flex-shrink: 0; margin-top: -4px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); }
  .language-trigger[aria-expanded="true"] .language-arrow { margin-top: 4px; transform: rotate(225deg); }
  .language-options { position: absolute; z-index: 20; top: calc(100% + 8px); right: 0; min-width: 100%; margin: 0; padding: 6px; border: 1px solid var(--line); background: var(--panel); box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3); list-style: none; }
  .language-options[hidden] { display: none; }
  .language-options a { display: flex; align-items: center; justify-content: space-between; gap: 20px; min-height: 44px; padding: 10px 12px; color: var(--text); text-decoration: none; white-space: nowrap; }
  .language-options a:hover, .language-options a:focus-visible { outline: none; background: var(--bg); color: var(--acid); }
  .language-options a[aria-current="page"] { color: var(--acid); }
</style>
