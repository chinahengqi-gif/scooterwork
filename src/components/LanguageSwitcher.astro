---
import { locales, localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  page?: string;
  variant?: "overlay" | "light";
}

const { locale, page = "", variant = "light" } = Astro.props;
const languageNames = { en: "English", de: "Deutsch", fr: "Français" };
---

<div class:list={["language-switcher", `language-switcher--${variant}`]}>
  <button class="language-trigger" type="button" aria-label={`${translations[locale].language}: ${languageNames[locale]}`} aria-expanded="false" aria-controls="language-options">
    <span lang={locale}>{languageNames[locale]}</span>
    <span class="language-arrow" aria-hidden="true"></span>
  </button>
  <ul class="language-options" id="language-options" aria-label={translations[locale].language} hidden>
    {locales.map((language) => (
      <li>
        <a href={localizedPath(language, page)} lang={language} hreflang={language} data-locale={language} aria-current={language === locale ? "page" : undefined}>
          {languageNames[language]}
          {language === locale && <span aria-hidden="true">✓</span>}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  document.querySelectorAll<HTMLElement>(".language-switcher").forEach((switcher) => {
    const trigger = switcher.querySelector<HTMLButtonElement>(".language-trigger")!;
    const options = switcher.querySelector<HTMLUListElement>(".language-options")!;
    const links = Array.from(options.querySelectorAll<HTMLAnchorElement>("a"));

    function setOpen(open: boolean) {
      options.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
    }

    trigger.addEventListener("click", () => setOpen(options.hidden));
    trigger.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;
      event.preventDefault();
      setOpen(true);
      links[event.key === "ArrowDown" ? 0 : links.length - 1].focus();
    });
    switcher.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !options.hidden) {
        event.preventDefault();
        setOpen(false);
        trigger.focus();
      }
    });
    options.addEventListener("keydown", (event) => {
      const current = links.indexOf(document.activeElement as HTMLAnchorElement);
      let next = current;
      if (event.key === "ArrowDown") next = (current + 1) % links.length;
      else if (event.key === "ArrowUp") next = (current - 1 + links.length) % links.length;
      else if (event.key === "Home") next = 0;
      else if (event.key === "End") next = links.length - 1;
      else return;
      event.preventDefault();
      links[next].focus();
    });
    document.addEventListener("click", (event) => {
      if (!switcher.contains(event.target as Node)) setOpen(false);
    });
    switcher.addEventListener("focusout", (event) => {
      if (!switcher.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    links.forEach((link) => {
      link.addEventListener("click", () => {
        try {
          localStorage.setItem("scooterwork-language", link.dataset.locale!);
        } catch {}
      });
    });
  });
</script>

<style>
  *, *::before, *::after { box-sizing: border-box; }
  .language-switcher { position: relative; display: inline-flex; font-size: 13px; font-weight: 600; }
  .language-trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-width: 118px;
    min-height: 38px;
    padding: 8px 14px;
    border-radius: 0;
    outline: none;
    font: inherit;
    cursor: pointer;
    transition: border-color 150ms ease, background 150ms ease;
  }
  .language-switcher--light .language-trigger {
    background: #ffffff;
    border: 1px solid #dce1e7;
    color: #111418;
  }
  .language-switcher--overlay .language-trigger {
    background: rgba(17, 24, 31, 0.45);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.36);
    color: #ffffff;
  }
  .language-trigger:hover,
  .language-trigger:focus-visible,
  .language-trigger[aria-expanded="true"] {
    border-color: #f56600;
  }
  .language-trigger:focus-visible {
    outline: 2px solid #f56600;
    outline-offset: 2px;
  }
  .language-arrow { width: 7px; height: 7px; flex-shrink: 0; margin-top: -3px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg); transition: transform 150ms ease; }
  .language-trigger[aria-expanded="true"] .language-arrow { margin-top: 3px; transform: rotate(225deg); }
  .language-options {
    position: absolute;
    z-index: 50;
    top: calc(100% + 8px);
    right: 0;
    min-width: 100%;
    margin: 0;
    padding: 6px;
    border: 1px solid #e2e6ec;
    border-radius: 0;
    background: #ffffff;
    color: #111418;
    box-shadow: 0 10px 28px rgba(15, 23, 42, 0.14);
    list-style: none;
  }
  .language-options[hidden] { display: none; }
  .language-options a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    min-height: 40px;
    padding: 8px 12px;
    border-radius: 0;
    color: #111418;
    text-decoration: none;
    white-space: nowrap;
    transition: background 140ms ease, color 140ms ease;
  }
  .language-options a:hover, .language-options a:focus-visible { outline: none; background: #f7f8fa; color: #f56600; }
  .language-options a[aria-current="page"] { color: #f56600; }
</style>
