---
import { locales, localizedPath, translations, type Locale } from "../i18n";

interface Props {
  locale: Locale;
  page?: string;
}

const { locale, page = "" } = Astro.props;
const languageNames = { en: "English", de: "Deutsch", fr: "Français" };
---

<label class="language-switcher">
  <span class="visually-hidden">{translations[locale].language}</span>
  <select name="language">
    {locales.map((language) => (
      <option value={language} lang={language} data-url={localizedPath(language, page)} selected={language === locale}>
        {languageNames[language]}
      </option>
    ))}
  </select>
</label>

<script>
  document.querySelectorAll<HTMLSelectElement>(".language-switcher select").forEach((select) => {
    select.addEventListener("change", () => {
      const destination = select.selectedOptions[0]?.dataset.url;
      if (!destination) return;
      try {
        localStorage.setItem("scooterwork-language", select.value);
      } catch {}
      window.location.assign(destination);
    });
  });
</script>

<style>
  .language-switcher { display: inline-flex; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
  select { min-height: 44px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 0; background: var(--bg); color: var(--text); font-family: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }
  select:hover { border-color: var(--acid); }
  select:focus-visible { outline: 2px solid var(--acid); outline-offset: 4px; }
</style>
