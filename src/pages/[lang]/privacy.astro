---
import PrivacyPage from "../../components/PrivacyPage.astro";
import type { Locale } from "../../i18n";

export function getStaticPaths() {
  return ["de", "fr"].map((lang) => ({ params: { lang }, props: { locale: lang } }));
}

interface Props {
  locale: Locale;
}
---

<PrivacyPage locale={Astro.props.locale} />
